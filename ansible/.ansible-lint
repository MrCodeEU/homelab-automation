---
# Ansible-lint configuration for homelab-automation
# https://ansible-lint.readthedocs.io/

profile: production

# Exclude paths
exclude_paths:
  - .git/
  - .github/
  - .cache/
  - inventory/group_vars/all/vault.yml

# Skip specific rules that don't fit our use case
skip_list:
  - yaml[line-length]  # Allow longer lines in templates
  - name[casing]       # Allow flexible task naming
  - risky-file-permissions  # We explicitly set permissions where needed
  - no-changed-when    # We'll gradually add these
  - command-instead-of-shell  # Sometimes shell is needed for pipes
  - command-instead-of-module  # A few system diagnostic commands are intentional
  - name[template]     # Service task names intentionally begin with the service name
  - no-handler         # Some changed-only debug output is deliberately inline
  - risky-shell-pipe   # Installer hooks and dotenv parsing use controlled shell snippets
  - role-name          # Existing role names use hyphens
  - var-naming         # Existing role variables predate role-prefix enforcement
  - yaml[truthy]       # Keep legacy yes/no values until broad YAML cleanup
  - package-latest     # Some infra packages intentionally track latest stable

# Warn but don't fail on these
warn_list:
  - experimental
  - jinja[spacing]
  - yaml[comments]

# Enable offline mode (no galaxy lookups)
offline: true

# Allow linting before collections are installed locally.
mock_modules:
  - ansible.posix.acl
  - ansible.posix.firewalld
  - ansible.posix.synchronize
  - ansible.posix.sysctl
  - community.docker.docker_compose_v2
  - community.docker.docker_compose_v2_pull
  - community.docker.docker_container
  - community.docker.docker_container_info
  - community.docker.docker_login
  - community.docker.docker_prune
  - community.general.ini_file
  - community.general.sefcontext
  - community.general.timezone
