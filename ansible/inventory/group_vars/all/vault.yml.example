---
# Ansible Vault — secret values template
# ============================================================================
# NEVER commit this file. The real vault.yml is encrypted and committed.
#
# To create vault.yml for the first time:
#   ansible-vault create ansible/inventory/group_vars/all/vault.yml
#   (paste this structure, fill in values, save)
#
# To edit existing vault.yml:
#   ansible-vault edit ansible/inventory/group_vars/all/vault.yml
#
# Store your vault password in your password manager (single value to remember).
# Add it to GitHub as secret ANSIBLE_VAULT_PASSWORD.
# ============================================================================

# Nocturne
vault_nocturne_instance_key: ""           # openssl rand -hex 32
vault_nocturne_base_domain: "nc.mljr.eu"
vault_nocturne_postgres_password: ""      # openssl rand -hex 16
vault_nocturne_postgres_app_password: ""  # openssl rand -hex 16
vault_nocturne_postgres_migrator_password: ""  # openssl rand -hex 16
vault_nocturne_postgres_web_password: ""  # openssl rand -hex 16

# Caddy basicauth (legacy fallback)
vault_caddy_auth_user: "admin"
vault_caddy_auth_hash: ""   # bcrypt hash — generate: caddy hash-password

# Authelia SSO
vault_authelia_jwt_secret: ""         # openssl rand -hex 32
vault_authelia_session_secret: ""     # openssl rand -hex 32
vault_authelia_storage_encryption_key: ""  # openssl rand -hex 32
vault_authelia_admin_password: ""

# Google OAuth (Authelia social login)
vault_google_client_id: ""
vault_google_client_secret: ""

# Uptime Kuma
vault_kuma_username: "admin"
vault_kuma_password: ""
vault_kuma_api_key: ""  # Kuma UI -> Profile -> API Keys; used as the basic-auth
                        # password (empty username) against /metrics

# Home Assistant (health report collector)
vault_homeassistant_token: ""  # HA -> profile (bottom left) -> Security ->
                                # Long-Lived Access Tokens -> Create Token

# ntfy notification bus
# Leave these empty to accept the defaults. The backup role only sends
# notifications when secrets.ntfy.url is defined.
vault_ntfy_url: "https://ntfy.mljr.eu"
vault_ntfy_topic: "backup"
vault_ntfy_token: ""  # only needed once ACLs are enabled in services/ntfy/server.yml

# Health report agent
vault_healthreport_ntfy_topic: "homelab-health"
vault_healthreport_email_to: ""  # where the daily report is mailed
# Fine-grained PAT owned by the account, "All repositories", read-only:
#   Metadata, Actions, Dependabot alerts, Code scanning alerts, Contents.
# Deliberately separate from vault_github_token (GHCR pull credential).
# Fine-grained PATs expire; the report warns about its own token at <14 days.
vault_github_readonly_token: ""

# Grafana
vault_grafana_admin_user: "admin"
vault_grafana_admin_password: ""

# CrowdSec
vault_crowdsec_firewall_bouncer_key: ""  # docker exec crowdsec cscli bouncers list
vault_crowdsec_web_ui_password: ""
vault_crowdsec_web_ui_notification_secret: ""  # openssl rand -hex 32

# Netronome / Speedtest
vault_netronome_admin_password: ""
vault_netronome_session_secret: ""   # openssl rand -hex 32

# Bichon (email archiver, legacy - being replaced by mail-archiver)
vault_bichon_encrypt_password: ""

# Mail Archiver (s1t5/mail-archiver)
vault_mailarchiver_db_password: ""     # openssl rand -hex 32
vault_mailarchiver_admin_user: "admin"
vault_mailarchiver_admin_password: ""  # openssl rand -hex 32

# TutaBridge headless CLI (nuc) - unlocks the persistent gnome-keyring
# "login" collection at boot so TutaBridge's own Tuta session survives
# across systemd timer runs. Not the Tuta account password itself.
vault_tutabridge_keyring_password: ""  # openssl rand -hex 32

# Sudoku service API
vault_sudoku_api_user: ""
vault_sudoku_api_password: ""

# Homepage live mesh panel (Tailscale API, read-only devices scope)
# Tailscale API keys cap out at 90 days — homepage ntfy-alerts to
# ntfy.mljr.eu/homepage on failure, but you'll still need to rotate this by
# hand: https://login.tailscale.com/admin/settings/keys
vault_homepage_tailscale_api_key: ""

# Homepage — Strava integration
vault_strava_client_id: ""
vault_strava_client_secret: ""
vault_strava_refresh_token: ""
# Umami
vault_homepage_umami_website_id: ""
vault_umami_app_secret: ""              # openssl rand -hex 32
vault_umami_postgres_password: ""       # openssl rand -hex 16

# Homepage contact form recipient (falls back to vault_smtp_from if unset)
vault_homepage_contact_to: ""

# Forgejo
vault_forgejo_postgres_password: ""     # openssl rand -hex 16
vault_forgejo_runner_secret: ""         # openssl rand -hex 20

# Docker Hub (avoid pull rate limits)
vault_dockerhub_username: ""
vault_dockerhub_token: ""

# GitHub (GHCR private image pulls)
vault_github_username: ""
vault_github_token: ""   # PAT with read:packages scope

# pCloud backup
vault_pcloud_token: ""   # rclone config → copy token JSON value

# WD MyCloud (semi-offsite, push-only). Copy both values verbatim from the
# existing [wd-cloud] remote in /root/.config/rclone/rclone.conf on nas -
# `pass` is already in rclone's obscured format, not plaintext.
vault_wd_cloud_user: "admin"
vault_wd_cloud_password: ""

# HetrixTools monitoring
vault_hetrixtools_api_token: ""

# SMTP (outbound email for notifications)
vault_smtp_host: ""
vault_smtp_port: "587"
vault_smtp_user: ""
vault_smtp_password: ""
vault_smtp_from: ""
