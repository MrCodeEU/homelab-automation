receivers:
  hostmetrics:
    collection_interval: 30s
    root_path: /hostfs
    scrapers:
      cpu: {}
      load: {}
      memory: {}
      disk: {}
      filesystem:
        exclude_mount_points:
          match_type: strict
          mount_points:
            - /dev/*
            - /proc/*
            - /sys/*
            - /run/*
            - /var/lib/docker/*
            - /snap/*
      network: {}
  
  docker_stats:
    endpoint: unix:///var/run/docker.sock
    api_version: "1.41"
    collection_interval: 30s

  filelog/caddy:
    include:
      - /hostfs/var/log/caddy/*.log
    exclude:
      - /hostfs/var/log/caddy/*.gz
      - /hostfs/var/log/caddy/access-*.log
    start_at: end
    include_file_name: true
    include_file_path: true
    operators:
      - type: add
        field: attributes["log.source"]
        value: caddy
      - type: add
        field: attributes["service.name"]
        value: caddy

  filelog/fail2ban:
    include:
      - /hostfs/var/log/fail2ban.log
    start_at: end
    include_file_name: true
    include_file_path: true
    operators:
      - type: add
        field: attributes["log.source"]
        value: fail2ban
      - type: add
        field: attributes["service.name"]
        value: fail2ban

processors:
  filter/drop_uptime_kuma:
    logs:
      log_record:
        - 'IsMatch(body, "Uptime-Kuma/")'
  batch:
    send_batch_size: 1000
    timeout: 10s
  resourcedetection:
    detectors: [env, system]
    timeout: 2s
    override: false

exporters:
  otlp:
    endpoint: "{{ signoz_otlp_endpoint }}"
    tls:
      insecure: true

service:
  pipelines:
    metrics:
      receivers: [hostmetrics, docker_stats]
      processors: [resourcedetection, batch]
      exporters: [otlp]
    logs:
      receivers: [filelog/caddy, filelog/fail2ban]
      processors: [filter/drop_uptime_kuma, resourcedetection, batch]
      exporters: [otlp]
