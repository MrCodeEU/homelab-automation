#!/bin/bash
# Unraid rclone backup
# Managed by Ansible (roles/unraid-backup) - do not edit manually
#
# Rides the rclone config that was already set up manually on this NAS
# (/root/.config/rclone/rclone.conf) - this script only owns the schedule and
# the path list.
#
# Summary block format matches ansible/roles/backup/templates/backup.sh.j2 so
# the health report's backup-log parser (homelab-facts.py.j2 collect_backup_log)
# works unmodified against either host's log.

set -uo pipefail

LOG_DIR="{{ unraid_backup_log_path }}"
LOG_FILE="${LOG_DIR}/backup-$(date +%Y%m%d).log"
mkdir -p "$LOG_DIR"

UGREEN_CONFIG="{{ base_path }}/backup-remote/rclone-ugreen.conf"
UGREEN_AVAILABLE=0
# A present config file does not mean a writable target. When ugreen's btrfs
# failed on 2026-07-31 the SFTP login still succeeded, so this leg was still
# attempted and every single file failed with
#   Put mkParentDir failed: mkdir "/nas" failed: permission denied
# One run spent three hours writing a 66MB log of those, and - worse - the
# remaining paths never got their pCloud sync because they were queued behind
# it. Probe for writability, not for the config file.
if [ -f "$UGREEN_CONFIG" ] && rclone --config "$UGREEN_CONFIG" mkdir "ugreen:probe-$$" \
        --timeout 20s --contimeout 20s --retries 1 >/dev/null 2>&1; then
    rclone --config "$UGREEN_CONFIG" rmdir "ugreen:probe-$$" >/dev/null 2>&1
    UGREEN_AVAILABLE=1
fi
# No "data/" prefix: the sftp session already lands directly in the backup
# user's home, which IS the data directory (see roles/backup-remote-target).

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"; }
log_error() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1" | tee -a "$LOG_FILE"; }
log_warn() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: $1" | tee -a "$LOG_FILE"; }

{% if secrets.ntfy is defined and secrets.ntfy.url is defined %}
send_notification() {
    curl -s -X POST "{{ secrets.ntfy.url }}/{{ secrets.ntfy.topic | default('backup') }}" \
        -H "Title: NAS Backup" -H "Priority: ${2:-default}" -H "Tags: backup,homelab,nas" \
        -d "$1" >/dev/null 2>&1 || log_warn "Failed to send notification"
}
{% else %}
send_notification() { log "Notification: $1"; }
{% endif %}

total_count=0
declare -a failed_paths=()
BACKUP_DATE="$(date +%Y%m%d)"

# --backup-dir moves anything `sync` would otherwise overwrite/delete into a
# dated subfolder instead - real point-in-time recovery for accidental
# deletes/ransomware, without switching tools (borg can't reach pCloud at
# all - no SSH support there, rclone/WebDAV only). Pruned at the end of this
# script, not by rclone itself.
#
# Must be a SIBLING of the sync destination, never nested inside it - rclone
# rejects "destination and parameter to --backup-dir mustn't overlap" as a
# fatal error otherwise (confirmed live 2026-08-14: every single leg failed
# instantly with exactly that message when this used <dest>/.deleted/<date>).
# A top-level .deleted/<name>/<date> per remote avoids any overlap.
#
# destinations lists where each entry goes, explicitly - replaces the old
# tier/wd_cloud model. pcloud in destinations -> ugreen failure there is
# just a warning (pcloud is authoritative); pcloud NOT in destinations ->
# ugreen failure is fatal (it's the only copy).
{% for pair in unraid_backup_paths %}
{% set has_pcloud = 'pcloud' in pair.destinations %}
total_count=$((total_count + 1))
{% if has_pcloud %}
log "Backing up {{ pair.src }} -> {{ pair.dest }} (pCloud)"
if rclone sync "{{ pair.src }}" "{{ pair.dest }}" \
    --backup-dir "pcloud:.deleted/{{ pair.name }}/${BACKUP_DATE}" \
    --exclude "**/.stfolder/**" \
{% for ex in pair.extra_excludes | default([]) %}
    --exclude "**/{{ ex }}/**" \
{% endfor %}
    --transfers 4 --checkers 8 --log-file="$LOG_FILE" --log-level INFO; then
    log "SUCCESS: {{ pair.src }} backed up to pCloud"
else
    log_error "Failed to sync {{ pair.src }} to pCloud"
    failed_paths+=("{{ pair.dest }}")
fi
{% endif %}
{% if 'ugreen' in pair.destinations %}
if [ "$UGREEN_AVAILABLE" = "1" ]; then
    log "Backing up {{ pair.src }} -> ugreen:{{ inventory_hostname }}/{{ pair.name }}"
    # transfers stays low (2) - ugreen/WD are weaker hardware, keep write
    # pressure light. checkers only does metadata listing, not writes, so it
    # can run higher without adding load to the destination; on deep,
    # heavily-nested trees (e.g. date-organized photo folders) checkers=4
    # made the listing pass itself the bottleneck, not the actual transfer.
    #
    # .stfolder markers are Syncthing-internal (one per nested folder root)
    # and can go stale on the source side when folders get reconsolidated -
    # some SMB targets (WD MyCloud) veto deleting anything matching that
    # pattern even when it no longer exists, which turned into a permanent
    # sync failure. They're not backup-worthy content either way, so keep
    # rclone from trying to reconcile them at all.
    if rclone --config "$UGREEN_CONFIG" sync "{{ pair.src }}" "ugreen:{{ inventory_hostname }}/{{ pair.name }}" \
        --backup-dir "ugreen:{{ inventory_hostname }}/.deleted/{{ pair.name }}/${BACKUP_DATE}" \
        --exclude "**/.stfolder/**" \
{% for ex in pair.extra_excludes | default([]) %}
    --exclude "**/{{ ex }}/**" \
{% endfor %}
        --transfers 2 --checkers 8 --log-file="$LOG_FILE" --log-level INFO; then
        log "SUCCESS: {{ pair.src }} backed up to ugreen"
    else
{% if has_pcloud %}
        log_warn "Failed to sync {{ pair.src }} to ugreen (on-prem copy only, pCloud leg above is authoritative)"
{% else %}
        log_error "Failed to sync {{ pair.src }} to ugreen (its only backup destination)"
        failed_paths+=("{{ pair.name }} (ugreen)")
{% endif %}
    fi
fi
{% endif %}
{% if 'wd_cloud' in pair.destinations %}
# Semi-offsite, push-only WD MyCloud - rides the [wd-cloud] remote already
# present in this NAS's own /root/.config/rclone/rclone.conf (manually set
# up, not managed by this role). Best-effort like ugreen: never turns an
# otherwise-successful pCloud backup into a reported failure.
log "Backing up {{ pair.src }} -> {{ pair.wd_cloud_dest }}"
# See the ugreen leg above for why checkers is higher than transfers here,
# and why .stfolder is excluded.
#
# --backup-dir must live inside an EXISTING SMB share (confirmed live
# 2026-08-17: wd-cloud:.deleted failed with "Network Name Not Found" -
# unlike pCloud/SFTP, SMB shares are fixed on the server, rclone can't
# create a new one just by writing to it). "backup" is a real share this
# device already has (same one roles/backup's sync_to_wdcloud writes real
# content into) and isn't itself a sync destination for anything here, so
# nesting .deleted under it can't overlap with pair.wd_cloud_dest.
if rclone sync "{{ pair.src }}" "{{ pair.wd_cloud_dest }}" \
    --backup-dir "wd-cloud:backup/.deleted/{{ pair.name }}/${BACKUP_DATE}" \
    --exclude "**/.stfolder/**" \
{% for ex in pair.extra_excludes | default([]) %}
    --exclude "**/{{ ex }}/**" \
{% endfor %}
    --transfers 2 --checkers 8 --log-file="$LOG_FILE" --log-level INFO; then
    log "SUCCESS: {{ pair.src }} backed up to wd-cloud"
else
    log_warn "Failed to sync {{ pair.src }} to wd-cloud (push-only copy, not fatal)"
    # Not fatal to the run (pCloud/ugreen legs above are authoritative), but
    # still needs to be visible - previously this only hit the log file, so a
    # dead or unreachable WD Cloud device could fail silently forever.
    failed_paths+=("{{ pair.name }} (wd-cloud)")
fi
{% endif %}
{% endfor %}

# Prune .deleted/ point-in-time folders older than the retention window -
# --backup-dir keeps every changed/deleted file forever otherwise.
log "Pruning .deleted/ folders older than {{ unraid_backup_deleted_retention_days }} days"
{% for pair in unraid_backup_paths %}
{% if 'pcloud' in pair.destinations %}
rclone delete --min-age {{ unraid_backup_deleted_retention_days }}d "pcloud:.deleted/{{ pair.name }}" >/dev/null 2>&1 || true
{% endif %}
{% if 'ugreen' in pair.destinations %}
[ "$UGREEN_AVAILABLE" = "1" ] && rclone --config "$UGREEN_CONFIG" delete --min-age {{ unraid_backup_deleted_retention_days }}d "ugreen:{{ inventory_hostname }}/.deleted/{{ pair.name }}" >/dev/null 2>&1 || true
{% endif %}
{% if 'wd_cloud' in pair.destinations %}
rclone delete --min-age {{ unraid_backup_deleted_retention_days }}d "wd-cloud:backup/.deleted/{{ pair.name }}" >/dev/null 2>&1 || true
{% endif %}
{% endfor %}

log "=========================================="
log "Backup Summary"
log "=========================================="
log "Total services: $total_count"
log "Successful: $((total_count - {% raw %}${#failed_paths[@]}{% endraw %}))"
# Nothing on this NAS backup path is marked critical yet (unlike the rocky
# backup role) - always reports 0 to match its log schema without asserting
# a severity this role does not yet enforce.
log "Critical failures: 0"
log "Non-critical failures: {% raw %}${#failed_paths[@]}{% endraw %}"

if [ {% raw %}${#failed_paths[@]}{% endraw %} -gt 0 ]; then
    log_warn "Non-critical backup failures: ${failed_paths[*]}"
    send_notification "⚠️ NAS backup failures: ${failed_paths[*]}" "default"
else
    log "SUCCESS: All backups completed successfully!"
    send_notification "✅ NAS backups completed successfully ($total_count/$total_count)"
fi

# 30-day retention, matching the rocky backup role's default.
find "$LOG_DIR" -name "backup-*.log" -mtime +30 -delete 2>/dev/null || true
