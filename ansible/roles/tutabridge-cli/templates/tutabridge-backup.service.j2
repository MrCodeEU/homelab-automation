[Unit]
Description=TutaBridge - export Tuta mail to local .eml files
Requires=gnome-keyring-daemon.service
After=gnome-keyring-daemon.service network-online.target
Wants=network-online.target
{% if tutabridge_mailarchiver_account_id %}
OnSuccess=tutabridge-import.service
{% endif %}

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
ExecStart={{ tutabridge_binary }} backup {{ tutabridge_export_dir }}
