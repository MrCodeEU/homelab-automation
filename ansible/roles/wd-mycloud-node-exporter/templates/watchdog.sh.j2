#!/bin/sh
NE_DIR={{ wd_node_exporter_base }}/current
LOG={{ wd_node_exporter_base }}/node_exporter.log
if ! pgrep -f "node_exporter --web.listen-address" >/dev/null 2>&1; then
    # Retry loop, not a single attempt: confirmed live 2026-08-12 that when
    # this fires from the clamAV/start.sh boot hook (see
    # ansible/roles/wd-mycloud-node-exporter/tasks/main.yml for why that
    # exists), the persistent /mnt/HD/HD_a2 partition isn't always fully
    # mounted yet that early in boot - "nohup: can't execute ...: No such
    # file or directory" even though the binary is really there moments
    # later. Cron-triggered invocations (every 5min, once cron itself
    # exists again post-deploy) hit this immediately anyway.
    i=0
    while [ ! -x "$NE_DIR/node_exporter" ] && [ "$i" -lt 12 ]; do
        sleep 5
        i=$((i + 1))
    done
    cd "$NE_DIR"
    nohup ./node_exporter --web.listen-address=100.100.10.5:{{ wd_node_exporter_port }} >> "$LOG" 2>&1 &
fi
