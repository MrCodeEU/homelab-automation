#!/bin/bash
# Homelab Backup Script
# Managed by Ansible - do not edit manually
# Generated: {{ lookup('pipe', 'date -u +%Y-%m-%dT%H:%M:%SZ') }}

set -euo pipefail

# Configuration
REMOTE="{{ backup_remote_name }}:{{ backup_remote_path }}"
LOCAL_PATH="{{ backup_local_path }}"
# On-prem second copy on the Ugreen NAS. Best-effort: a missing key (e.g. this
# host was skipped in the play that generates and distributes it) or an
# unreachable ugreen just means this run has no on-prem leg, not a failure -
# see UGREEN_KEY checks in backup_volume/backup_path.
UGREEN_KEY="/opt/backup-remote/ssh/id_ed25519"
# No "data/" prefix: the sftp session already lands directly in the backup
# user's home, which IS the data directory (see roles/backup-remote-target).
UGREEN_REMOTE="ugreen:{{ inventory_hostname }}"
# Semi-offsite, push-only WD MyCloud - every service gets this leg by
# default (2026-08-14: total volume across every mljr/nuc service backup is
# ~1GB, negligible against WD's free space), same as ugreen. Set
# backup_wd_cloud: false on a service to opt out.
WD_CLOUD_REMOTE="wd-cloud:"
LOG_FILE="${LOCAL_PATH}/logs/backup-$(date +%Y%m%d).log"
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
RETENTION_DAYS={{ backup_retention_days }}
# Wall-clock budget per rsync/rclone call. Without this, one slow item (a huge
# tiny-file volume like loki-data, or a stalled remote connection that outlasts
# rclone's own retry/backoff budget) burns the whole systemd TimeoutStartSec
# and SIGTERMs the script mid-list - which fails every service queued after
# it too, not just the slow one. 2026-08-03: this is exactly what happened -
# nuc died on loki-data and never got to bichon/umami/forgejo; mljr stalled on
# mailcow's data path and never got to crowdsec/newsletter. Wrapping each call
# means a timeout only fails that one item; everything else still runs.
ITEM_TIMEOUT="{{ backup_item_timeout | default('20m') }}"
# pCloud leg concurrency/bandwidth - see roles/backup/defaults/main.yml for
# why this is host-overridable (mljr's own backup made itself unreachable).
PCLOUD_TRANSFERS="{{ backup_transfers | default(8) }}"
PCLOUD_CHECKERS="{{ backup_checkers | default(16) }}"
{% if backup_bwlimit %}
PCLOUD_BWLIMIT_ARGS=(--bwlimit "{{ backup_bwlimit }}")
{% else %}
PCLOUD_BWLIMIT_ARGS=()
{% endif %}
{% if secrets.ntfy is defined and secrets.ntfy.url is defined %}
NTFY_URL="{{ secrets.ntfy.url | default('https://ntfy.mljr.eu') }}"
NTFY_TOPIC="{{ secrets.ntfy.topic | default('backup') }}"
{% endif %}

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Error handler
error_handler() {
    local line_number=$1
    local error_code=$2
    log_error "Script failed at line $line_number with exit code $error_code"
    send_notification "❌ Backup failed at line $line_number" "high"
    exit "$error_code"
}

# Set error trap
trap 'error_handler ${LINENO} $?' ERR

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

log_error() {
    echo -e "${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1${NC}" | tee -a "$LOG_FILE"
}

log_success() {
    echo -e "${GREEN}[$(date '+%Y-%m-%d %H:%M:%S')] SUCCESS: $1${NC}" | tee -a "$LOG_FILE"
}

log_warn() {
    echo -e "${YELLOW}[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: $1${NC}" | tee -a "$LOG_FILE"
}

send_notification() {
    local message="$1"
    local priority="${2:-default}"
{% if secrets.ntfy is defined and secrets.ntfy.url is defined %}
    curl -s -X POST "${NTFY_URL}/${NTFY_TOPIC}" \
        -H "Title: Homelab Backup" \
        -H "Priority: ${priority}" \
        -H "Tags: backup,homelab" \
        -d "$message" >/dev/null 2>&1 || log_warn "Failed to send notification"
{% else %}
    log "Notification: $message"
{% endif %}
}

# Probed once per run, not per item. A present key and a working SSH login do
# not mean a writable target: when ugreen's btrfs failed on 2026-07-31 the SFTP
# session still authenticated and every single transfer then failed with
#   Put mkParentDir failed: mkdir "/nuc" failed: permission denied
# three times over (rclone's own retries), for every volume and path, on every
# host, every night. Same probe as roles/unraid-backup's script, which got this
# first because the NAS hit it harder.
UGREEN_AVAILABLE=0
probe_ugreen() {
    [ -f "$UGREEN_KEY" ] || return 0
    if timeout 60s rclone mkdir "${UGREEN_REMOTE}-probe-$$" \
            --sftp-key-file "$UGREEN_KEY" \
            --timeout 20s --contimeout 20s --retries 1 >/dev/null 2>&1; then
        timeout 60s rclone rmdir "${UGREEN_REMOTE}-probe-$$" \
            --sftp-key-file "$UGREEN_KEY" >/dev/null 2>&1
        UGREEN_AVAILABLE=1
    else
        log_warn "ugreen is not writable - skipping the on-prem leg for this run"
    fi
}

# Best-effort on-prem sync. Logs its own outcome but never sets the caller's
# service_failed - a down or unconfigured ugreen must not turn an otherwise
# successful pCloud backup into a reported failure.
sync_to_ugreen() {
    local snapshot_dir="$1"
    local remote_suffix="$2"

    if [ "$UGREEN_AVAILABLE" != "1" ]; then
        return 0
    fi

    timeout "$ITEM_TIMEOUT" rclone sync "$snapshot_dir" "${UGREEN_REMOTE}/${remote_suffix}" \
        --sftp-key-file "$UGREEN_KEY" \
        --transfers 2 --checkers 4 \
        --timeout 60s --contimeout 20s --low-level-retries 3 \
        --log-file="$LOG_FILE" --log-level INFO || {
        log_warn "Failed to sync ${remote_suffix} to ugreen (on-prem copy only, not fatal)"
        return 1
    }
    return 0
}

sync_to_wdcloud() {
    local snapshot_dir="$1"
    local remote_suffix="$2"

    timeout "$ITEM_TIMEOUT" rclone sync "$snapshot_dir" "${WD_CLOUD_REMOTE}backup/${remote_suffix}" \
        --transfers 2 --checkers 4 \
        --timeout 60s --contimeout 20s --low-level-retries 3 \
        --log-file="$LOG_FILE" --log-level INFO || {
        log_warn "Failed to sync ${remote_suffix} to wd-cloud (push-only copy, not fatal)"
        return 1
    }
    return 0
}

backup_volume() {
    local volume_name="$1"
    local wd_cloud="${2:-true}"

    # Dynamically detect Docker volume path
    local volume_path=$(docker volume inspect --format '{{ '{{' }}.Mountpoint{{ '}}' }}' "$volume_name" 2>/dev/null)

    if [ -z "$volume_path" ] || [ ! -d "$volume_path" ]; then
        log_warn "Volume $volume_name not found or invalid path: $volume_path"
        return 1
    fi

    log "Backing up Docker volume: $volume_name"

    # Create snapshot directory
    local snapshot_dir="${LOCAL_PATH}/volumes/${volume_name}"
    mkdir -p "$snapshot_dir"

    # Use rsync for incremental backup
    timeout "$ITEM_TIMEOUT" rsync -a --delete --info=progress2 "$volume_path/" "$snapshot_dir/" 2>> "$LOG_FILE" || {
        log_error "Failed to rsync volume $volume_name"
        return 1
    }

    # Sync to remote
    timeout "$ITEM_TIMEOUT" rclone sync "$snapshot_dir" "${REMOTE}/volumes/${volume_name}" \
        --progress \
        --transfers "$PCLOUD_TRANSFERS" \
        --checkers "$PCLOUD_CHECKERS" \
        "${PCLOUD_BWLIMIT_ARGS[@]}" \
        --timeout 60s --contimeout 20s --low-level-retries 3 \
        --log-file="$LOG_FILE" \
        --log-level INFO || {
        log_error "Failed to sync volume $volume_name to remote"
        return 1
    }

    sync_to_ugreen "$snapshot_dir" "volumes/${volume_name}"

    if [ "$wd_cloud" = "true" ]; then
        sync_to_wdcloud "$snapshot_dir" "volumes/${volume_name}"
    fi

    log_success "Volume $volume_name backed up successfully"
    return 0
}

backup_path() {
    local source_path="$1"
    # "optional" means the path is expected not to exist yet, for a service
    # that is registered for backup but not configured. Without this, such a
    # service reports a failure every single night until someone gets round to
    # setting it up, which trains you to ignore backup warnings.
    local optional="${2:-false}"
    local wd_cloud="${3:-true}"
    local backup_name=$(basename "$source_path")

    if [ ! -d "$source_path" ]; then
        if [ "$optional" = "true" ]; then
            log "Skipping optional path $source_path (not configured yet)"
            return 0
        fi
        log_warn "Path $source_path not found"
        return 1
    fi

    log "Backing up path: $source_path"

    # Sync to remote
    timeout "$ITEM_TIMEOUT" rclone sync "$source_path" "${REMOTE}/paths/${backup_name}" \
        --progress \
        --transfers "$PCLOUD_TRANSFERS" \
        --checkers "$PCLOUD_CHECKERS" \
        "${PCLOUD_BWLIMIT_ARGS[@]}" \
        --timeout 60s --contimeout 20s --low-level-retries 3 \
        --log-file="$LOG_FILE" \
        --log-level INFO || {
        log_error "Failed to sync path $source_path to remote"
        return 1
    }

    sync_to_ugreen "$source_path" "paths/${backup_name}"

    if [ "$wd_cloud" = "true" ]; then
        sync_to_wdcloud "$source_path" "${backup_name}"
    fi

    log_success "Path $source_path backed up successfully"
    return 0
}

run_pre_hook() {
    local service="$1"
    local hook="$2"

    if [ -n "$hook" ]; then
        log "Running pre-backup hook for $service"
        bash -c "$hook" 2>> "$LOG_FILE" || {
            log_warn "Pre-backup hook for $service failed"
            return 1
        }
    fi
    return 0
}

run_post_hook() {
    local service="$1"
    local hook="$2"

    if [ -n "$hook" ]; then
        log "Running post-backup hook for $service"
        bash -c "$hook" 2>> "$LOG_FILE" || {
            log_warn "Post-backup hook for $service failed"
            return 1
        }
    fi
    return 0
}

cleanup_old_logs() {
    log "Cleaning up logs older than $RETENTION_DAYS days"
    find "${LOCAL_PATH}/logs" -name "backup-*.log" -mtime +${RETENTION_DAYS} -delete 2>/dev/null || true
}

# Main backup function
main() {
    log "=========================================="
    log "Starting homelab backup - $TIMESTAMP"
    log "=========================================="

    local failed_critical=()
    local failed_noncritical=()
    local success_count=0
    local total_count=0

    # Once per run: every service below asks sync_to_ugreen, and without this
    # each one would rediscover the same dead remote at rclone's own pace.
    probe_ugreen

{% for item in backup_host_service_configs | default(backup_service_configs) | dict2items %}
{% set service = item.key %}
{% set config = item.value %}
    # Backup {{ service }}
    log "Processing service: {{ service }}"
    total_count=$((total_count + 1))
    service_failed=false

{% if config.backup_pre_hook is defined %}
    run_pre_hook "{{ service }}" '{{ config.backup_pre_hook | replace("'", "'\\''") }}' || service_failed=true
{% endif %}

{% if config.backup_volumes is defined %}
{% for volume in config.backup_volumes %}
    backup_volume "{{ volume }}" "{{ config.backup_wd_cloud | default(true) | string | lower }}" || service_failed=true
{% endfor %}
{% endif %}

{% if config.backup_paths is defined %}
{% for path in config.backup_paths %}
    backup_path "{{ path }}" "{{ config.backup_optional | default(false) | string | lower }}" "{{ config.backup_wd_cloud | default(true) | string | lower }}" || service_failed=true
{% endfor %}
{% endif %}

{% if config.backup_post_hook is defined %}
    run_post_hook "{{ service }}" '{{ config.backup_post_hook | replace("'", "'\\''") }}' || service_failed=true
{% endif %}

    if [ "$service_failed" = true ]; then
{% if config.backup_critical | default(false) %}
        failed_critical+=("{{ service }}")
        log_error "Critical service {{ service }} backup failed!"
{% else %}
        failed_noncritical+=("{{ service }}")
        log_warn "Non-critical service {{ service }} backup failed"
{% endif %}
    else
        success_count=$((success_count + 1))
        log_success "Service {{ service }} backup completed"
    fi

{% endfor %}

    # Cleanup old logs
    cleanup_old_logs

    # Summary
    log "=========================================="
    log "Backup Summary"
    log "=========================================="
    log "Total services: $total_count"
    log "Successful: $success_count"
    log "Critical failures: {% raw %}${#failed_critical[@]}{% endraw %}"
    log "Non-critical failures: {% raw %}${#failed_noncritical[@]}{% endraw %}"

    if [ {% raw %}${#failed_critical[@]}{% endraw %} -gt 0 ]; then
        log_error "Critical backup failures: ${failed_critical[*]}"
        send_notification "❌ Critical backup failures: ${failed_critical[*]}" "high"
        exit 1
    fi

    if [ {% raw %}${#failed_noncritical[@]}{% endraw %} -gt 0 ]; then
        log_warn "Non-critical backup failures: ${failed_noncritical[*]}"
        send_notification "⚠️ Non-critical backup failures: ${failed_noncritical[*]}" "default"
    fi

    log_success "Critical backups completed successfully!"
    send_notification "✅ All backups completed successfully ($success_count/$total_count)" "default"
    exit 0
}

# Run main function
main "$@"
