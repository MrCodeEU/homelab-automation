[Unit]
Description=Homelab Backup Service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ backup_local_path }}/scripts/backup.sh
StandardOutput=journal
StandardError=journal
# Backstop only - each individual rsync/rclone call inside backup.sh.j2 is
# now capped at ITEM_TIMEOUT (default 20m), so a single stuck item can no
# longer silently consume this whole budget and take every service queued
# after it down too. This just needs headroom for several capped items in a
# row, not protection against one unbounded one.
TimeoutStartSec=10800
Nice=19
IOSchedulingClass=idle
{% if backup_cpu_quota %}
# Nice/idle IO only win when something else is contending at that instant -
# a hard cap guarantees headroom regardless of scheduling luck. Set per-host
# where the box also runs the services being backed up (see
# roles/backup/defaults/main.yml).
CPUQuota={{ backup_cpu_quota }}
{% endif %}

[Install]
WantedBy=multi-user.target
