[Unit]
Description=Sync mljr-data site-data.json for homepage
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -fsSL -o {{ homepage_data_sync_path }}/site-data.json.tmp {{ homepage_data_sync_url }}
ExecStartPost=/bin/mv {{ homepage_data_sync_path }}/site-data.json.tmp {{ homepage_data_sync_path }}/site-data.json
StandardOutput=journal
StandardError=journal
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
