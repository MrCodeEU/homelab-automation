{# ============================================================================ #}
{# Authentication Macros                                                        #}
{# ============================================================================ #}

{# Macro: Basic authentication block #}
{% macro basicauth_block() %}
    basicauth {
        {{ secrets.caddy.auth_user }} {{ secrets.caddy.auth_hash }}
    }
{% endmacro %}

{# Macro: Authelia SSO authentication #}
{% macro authelia_auth() %}
    # Forward authentication to Authelia
    # Headers copied for user identity and authorization downstream
    forward_auth http://localhost:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
{% endmacro %}

{# Macro: Keycloak SSO authentication via oauth2-proxy (deprecated) #}
{% macro keycloak_auth() %}
    # OAuth2 proxy callback routes
    # Ensure oauth2 endpoints are handled directly by the proxy (avoid auth loop)
    handle /oauth2/* {
        reverse_proxy http://localhost:4180 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Uri {uri}
        }
    }

    # Forward authentication to oauth2-proxy for all other requests
    @auth {
        not path /oauth2/*
    }
    forward_auth @auth http://localhost:4180 {
        uri /oauth2/auth
        header_up X-Real-IP {remote}
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Uri {uri}
        header_up X-Forwarded-Host {host}
        copy_headers X-Auth-Request-User X-Auth-Request-Email

        # Redirect to login page when not authenticated
        @error status 401
        handle_response @error {
            redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
        }
    }
{% endmacro %}

{# ============================================================================ #}

{
    email {{ email }}
}

# Deployment Status Page
deploy.{{ domain }} {
    root * {{ base_path }}/caddy/site
    file_server
    log {
        output file {{ log_path }}/caddy/deploy.log {
            roll_disabled
        }
    }
}

