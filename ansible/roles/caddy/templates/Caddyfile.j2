{%- macro add_env_suffix(domain_name, service) -%}
{%- if is_staging_deployment | bool and service.name in services_with_dev | default([]) -%}
  {%- set parts = domain_name.split('.') -%}
  {%- if parts | length == 2 -%}
    {# Root domain like mljr.eu becomes <service.name>.dev.mljr.eu #}
    {{ service.name ~ '.dev.' ~ domain_name }}
  {%- else -%}
    {# Subdomain like home.mljr.eu becomes home.dev.mljr.eu #}
    {{ parts[0] ~ '.dev.' ~ parts[1:] | join('.') }}
  {%- endif -%}
{%- else -%}
{{ domain_name }}
{%- endif -%}
{%- endmacro -%}

{
    email {{ email }}
}

deployment-status.{{ domain }} {
    root * /opt/caddy/site
    file_server
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

{% for service in services %}
{% if service.enabled | default(true) %}
{% if service.domain is string %}
{{ add_env_suffix(service.domain, service) }} {
{% else %}
{% set env_domains = [] %}
{% for d in service.domain %}
{% set _ = env_domains.append(add_env_suffix(d, service)) %}
{% endfor %}
{{ env_domains | join(', ') }} {
{% endif %}
    log {
        output file /var/log/caddy/access.log
        format json
    }
    {% if service.name == 'goaccess' %}
    # WebSocket support for GoAccess real-time updates
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    
    # WebSocket connections pass through without auth
    handle @websocket {
        reverse_proxy localhost:{{ service.port }}
    }
    
    # Regular HTTP requests require basicauth
    {% if service.caddy_auth is defined and service.caddy_auth == 'basicauth' %}
    handle {
        basicauth {
            {{ caddy_auth_user | default('admin', true) }} {{ caddy_admin_hash | default('$2a$12$mZT3tHnQr1gLXPnY8XMqVefFpEVSJIEEl3AGrBsslH.9OPzA0S8ta') }}
        }
        reverse_proxy localhost:{{ service.port }}
    }
    {% else %}
    handle {
        reverse_proxy localhost:{{ service.port }}
    }
    {% endif %}
    {% else %}
    {% if service.caddy_auth is defined and service.caddy_auth == 'basicauth' %}
    basicauth {
        {{ caddy_auth_user | default('admin', true) }} {{ caddy_admin_hash | default('$2a$14$Zo8o.zRZF4lRZLj7J9yVVuMPvkHZKp7LcZhQsP2gQy5YZ9P8V9ZGe') }}
    }
    {% endif %}
    
    {% if service.upstream is defined %}
    reverse_proxy {{ service.upstream }}
    {% else %}
    {% if service.host == inventory_hostname %}
    reverse_proxy localhost:{{ service.port }}
    {% else %}
    reverse_proxy {{ hostvars[service.host]['ansible_host'] }}:{{ service.port }}
    {% endif %}
    {% endif %}
    {% endif %}
}
{% endif %}
{% endfor %}
