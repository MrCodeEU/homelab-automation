# Caddyfile - Auto-generated by Ansible
# Last updated: {{ lookup('pipe', 'date -u +%Y-%m-%dT%H:%M:%SZ') }}
# NOTE: This file is validated with 'caddy validate --adapter caddyfile' before deployment
# Service configs live in /etc/caddy/conf.d/ — one snippet per service
# ============================================================================

{
    email {{ email }}

    servers {
        timeouts {
            # Allow slow mobile clients to finish large uploads without Caddy returning 408.
            read_body 0
        }
    }

    # Global access log for GoAccess real-time analytics
    log access {
        output file {{ log_path }}/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# Deployment Status Page
deploy.{{ domain }} {
    root * {{ base_path }}/caddy/site
    file_server
    log {
        output file {{ log_path }}/caddy/deploy.log {
            roll_disabled
        }
    }
}

# Per-service snippets (auth macros + individual service configs)
import /etc/caddy/conf.d/*.caddy
