prometheus.exporter.unix "host" {
  rootfs_path = "/hostfs"
  procfs_path = "/hostfs/proc"
  sysfs_path  = "/hostfs/sys"

  // systemd exposes node_systemd_unit_state, which the health report uses to
  // detect failed units. Not enabled by default.
  enable_collectors = ["systemd"]

  // btrfs is disabled deliberately. The collector stats the block device
  // directly, and Alloy runs in a container without the device nodes, so on a
  // host with a btrfs filesystem every scrape logs
  //   Unable to get btrfs mountpoint IDs: stat failed on /dev/sde1
  // On nas that started the moment the new pool was created and produced
  // ~1.1M log lines a day - more than every other container on the estate
  // combined. Capacity for those filesystems already comes from the `filesystem`
  // collector, which reads /proc/mounts and works fine, so nothing is lost.
  disable_collectors = ["btrfs"]
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.identity.receiver]
  job_name   = "node"
}

prometheus.exporter.cadvisor "docker" {
  docker_host      = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}

prometheus.scrape "docker" {
  targets    = prometheus.exporter.cadvisor.docker.targets
  forward_to = [prometheus.relabel.identity.receiver]
  job_name   = "docker"
}

{% if inventory_hostname == 'mljr' %}
prometheus.scrape "security" {
  targets = [
    {
      "__address__" = "127.0.0.1:6060",
      "job"         = "crowdsec",
      "instance"    = "{{ inventory_hostname }}",
    },
  ]
  forward_to = [prometheus.relabel.identity.receiver]
}

{% endif %}
// prometheus.scrape attaches its own `instance` label from the scrape target,
// which wins over remote_write's external_labels. That made mljr report as
// "vmi2945702.contaboserver.net" instead of its inventory name. Rewrite it
// here, before remote_write, so every series carries the inventory hostname.
prometheus.relabel "identity" {
  forward_to = [prometheus.remote_write.homelab.receiver]

  rule {
    target_label = "instance"
    replacement  = "{{ inventory_hostname }}"
  }

  rule {
    target_label = "host"
    replacement  = "{{ inventory_hostname }}"
  }
}

prometheus.remote_write "homelab" {
  endpoint {
    url = "{{ grafana_prometheus_remote_write_url }}"
  }

  external_labels = {
    instance = "{{ inventory_hostname }}",
    host     = "{{ inventory_hostname }}",
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Without this, the static `labels` block below replaces everything discovery
// produced and the container name is lost - every Docker log line arrives
// unattributable. Promote the name to a real `container` label first.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {
    job      = "docker",
    instance = "{{ inventory_hostname }}",
    host     = "{{ inventory_hostname }}",
  }
  forward_to = [loki.process.recent.receiver]
}

loki.process "recent" {
  forward_to = [loki.write.homelab.receiver]

  stage.drop {
    older_than          = "168h"
    drop_counter_reason = "too_old"
  }
}

loki.source.file "system_logs" {
  targets = [
    {
      "__path__" = "/var/log/messages",
      "job"      = "system",
      "instance" = "{{ inventory_hostname }}",
      "host"     = "{{ inventory_hostname }}",
    },
    {
      "__path__" = "/var/log/secure",
      "job"      = "auth",
      "instance" = "{{ inventory_hostname }}",
      "host"     = "{{ inventory_hostname }}",
    },
{% if inventory_hostname == 'mljr' %}
    {
      "__path__"         = "/var/log/caddy/*.log",
      "__path_exclude__" = "/var/log/caddy/*.gz",
      "job"              = "caddy",
      "instance"         = "{{ inventory_hostname }}",
      "host"             = "{{ inventory_hostname }}",
    },
{% endif %}
  ]
  forward_to = [loki.process.recent.receiver]
  tail_from_end = true
  on_positions_file_error = "restart_from_end"

  file_match {
    enabled = true
  }
}

loki.write "homelab" {
  endpoint {
    url = "{{ grafana_loki_push_url }}"
  }
}
