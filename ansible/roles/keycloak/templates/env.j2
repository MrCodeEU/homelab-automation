# Auto-generated .env file for Keycloak
# Generated by Ansible at {{ lookup('pipe', 'date -u +%Y-%m-%dT%H:%M:%SZ') }}

# Common Settings
TZ={{ timezone }}

# Keycloak Admin
KEYCLOAK_ADMIN={{ keycloak_admin_user }}
KEYCLOAK_ADMIN_PASSWORD={{ secrets.keycloak.admin_password }}
KC_DB_PASSWORD={{ secrets.keycloak.db_password }}
KC_HOSTNAME={{ keycloak_hostname }}

# Google OAuth (for social login)
GOOGLE_CLIENT_ID={{ secrets.google.client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ secrets.google.client_secret | default('') }}
