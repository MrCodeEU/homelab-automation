# Auto-generated .env file for {{ service_name }}

# ============================================================================
# Common Settings
# ============================================================================
TZ={{ timezone }}
DOMAIN={{ domain }}
EMAIL={{ email }}

# Host interface docker publishes ports on. Defaults to loopback-only so every
# service is only reachable through Caddy; set public_bind on the service
# entry in all.yml to opt a service out (e.g. public_bind: "0.0.0.0").
BIND_ADDR={{ bind_addr }}

# ============================================================================
# Service-specific Secrets
# ============================================================================
{% if secrets is defined %}
{% if service_name == 'nocturne' %}
# Nocturne
INSTANCE_KEY={{ secrets.nocturne.instance_key | default('') }}
BASE_DOMAIN={{ secrets.nocturne.base_domain | default('nc.mljr.eu') }}
POSTGRES_USERNAME=nocturne
POSTGRES_PASSWORD={{ secrets.nocturne.postgres_password | default('') }}
POSTGRES_APP_PASSWORD={{ secrets.nocturne.postgres_app_password | default('') }}
POSTGRES_MIGRATOR_PASSWORD={{ secrets.nocturne.postgres_migrator_password | default('') }}
POSTGRES_WEB_PASSWORD={{ secrets.nocturne.postgres_web_password | default('') }}
NOCTURNE_API_IMAGE=ghcr.io/nightscout/nocturne/nocturne-api:latest
NOCTURNE_API_PORT=8082
NOCTURNE_WEB_IMAGE=ghcr.io/nightscout/nocturne/nocturne-web:latest
{% endif %}

{% if service_name == 'nightscout' %}
# Nightscout
API_SECRET={{ secrets.nightscout.api_secret | default('') }}
NIGHTSCOUT_API_TOKEN={{ secrets.nightscout.api_token | default('') }}
NIGHTSCOUT_DOMAIN={{ secrets.nightscout.domain | default('') }}
# LibreLink
LINK_UP_USERNAME={{ secrets.librelink.username | default('') }}
LINK_UP_PASSWORD={{ secrets.librelink.password | default('') }}
{% endif %}

{% if service_name == 'bichon' %}
# Bichon
BICHON_ENCRYPT_PASSWORD={{ secrets.bichon.encrypt_password | default('') }}
{% endif %}

{% if service_name == 'sudoku' %}
# Sudoku external upload API credentials
SUDOKU_API_USER={{ secrets.sudoku.api_user | default('') }}
SUDOKU_API_PASSWORD={{ secrets.sudoku.api_password | default('') }}
{% endif %}

{% if service_name == 'homepage' %}
# GitHub
GH_TOKEN={{ secrets.github.token | default('') }}
# Strava
STRAVA_CLIENT_ID={{ secrets.homepage.strava_client_id | default('') }}
STRAVA_CLIENT_SECRET={{ secrets.homepage.strava_client_secret | default('') }}
STRAVA_REFRESH_TOKEN={{ secrets.homepage.strava_refresh_token | default('') }}
# Umami
UMAMI_WEBSITE_ID={{ secrets.homepage.umami_website_id | default('') }}
# Tailscale mesh panel (read-only devices-scope API key, caps out at 90 days)
TAILSCALE_API_KEY={{ secrets.homepage.tailscale_api_key | default('') }}
# SMTP for contact form notifications
SMTP_HOST={{ secrets.smtp.host | default('') }}
SMTP_PORT={{ secrets.smtp.port | default('587') }}
SMTP_USER={{ secrets.smtp.user | default('') }}
SMTP_PASSWORD={{ secrets.smtp.password | default('') }}
SMTP_FROM={{ secrets.smtp.from | default('contact@' ~ domain) }}
CONTACT_TO={{ secrets.homepage.contact_to | default(secrets.smtp.from) | default('') }}
{% endif %}

{% if service_name == 'umami' %}
# Umami
APP_SECRET={{ secrets.umami.app_secret | default('') }}
POSTGRES_PASSWORD={{ secrets.umami.postgres_password | default('') }}
{% endif %}

{% if service_name == 'forgejo' %}
# Forgejo
POSTGRES_PASSWORD={{ secrets.forgejo.postgres_password | default('') }}
FORGEJO_RUNNER_SECRET={{ secrets.forgejo.runner_secret | default('') }}
{% endif %}

{% if service_name == 'kuma' %}
# Uptime Kuma
KUMA_USERNAME={{ secrets.kuma.username | default('') }}
KUMA_PASSWORD={{ secrets.kuma.password | default('') }}
{% endif %}

{% if service_name == 'grafana' %}
# Grafana
GRAFANA_ADMIN_USER={{ secrets.grafana.admin_user | default('admin') }}
GRAFANA_ADMIN_PASSWORD={{ secrets.grafana.admin_password | default('') }}
{% endif %}

{% if service_name == 'crowdsec' %}
# CrowdSec
CROWDSEC_FIREWALL_BOUNCER_KEY={{ secrets.crowdsec.firewall_bouncer_key | default('') }}
CROWDSEC_WEB_UI_PASSWORD={{ secrets.crowdsec.web_ui_password | default('') }}
CROWDSEC_WEB_UI_NOTIFICATION_SECRET={{ secrets.crowdsec.web_ui_notification_secret | default('') }}
{% endif %}

{% if service_name == 'authelia' %}
# Authelia
AUTHELIA_JWT_SECRET={{ secrets.authelia.jwt_secret | default('') }}
AUTHELIA_SESSION_SECRET={{ secrets.authelia.session_secret | default('') }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ secrets.authelia.storage_encryption_key | default('') }}
AUTHELIA_ADMIN_PASSWORD={{ secrets.authelia.admin_password | default('') }}
# SMTP for email notifications
SMTP_HOST={{ secrets.smtp.host | default('') }}
SMTP_PORT={{ secrets.smtp.port | default('587') }}
SMTP_USER={{ secrets.smtp.user | default('') }}
SMTP_PASSWORD={{ secrets.smtp.password | default('') }}
SMTP_FROM={{ secrets.smtp.from | default('authelia@' ~ domain) }}
{% endif %}

{% if service_name == 'newsletter' %}
# Newsletter — reuses the shared SMTP secret, sends as its own address
SMTP_HOST={{ secrets.smtp.host | default('') }}
SMTP_PORT={{ secrets.smtp.port | default('587') }}
SMTP_USER={{ secrets.smtp.user | default('') }}
SMTP_PASS={{ secrets.smtp.password | default('') }}
SMTP_FROM=Newsletter <noreply@mljr.eu>
{% endif %}

{% if service_name == 'speedtest' %}
# Netronome
NETRONOME_ADMIN_PASSWORD={{ secrets.netronome.admin_password | default('') }}
NETRONOME_SESSION_SECRET={{ secrets.netronome.session_secret | default('') }}
# SMTP for speedtest notifications
SMTP_HOST={{ secrets.smtp.host | default('') }}
SMTP_PORT={{ secrets.smtp.port | default('587') }}
SMTP_USER={{ secrets.smtp.user | default('') }}
SMTP_PASSWORD={{ secrets.smtp.password | default('') }}
SMTP_FROM={{ secrets.smtp.from | default('speedtest@' ~ domain) }}
{% endif %}

{% if service_name == 'ollama' %}
# Consumed by hooks/post-deploy.sh to pull the triage model.
HEALTHREPORT_MODEL={{ healthreport_model | default('qwen3:8b') }}
{% endif %}

{% if service_name == 'syncthing-ugreen' %}
# The NAS's Syncthing API key, read live from its config.xml by
# roles/syncthing-nas-key and crossed here via hostvars - same pattern as the
# backup-to-ugreen and health-report facts-endpoint keys. Not a vault secret:
# it already exists on the NAS, set up manually, outside this repo.
NAS_SYNCTHING_URL=http://{{ hostvars['nas']['tailscale_ip'] }}:8384
NAS_SYNCTHING_API_KEY={{ hostvars['nas']['nas_syncthing_api_key'] | default('') }}
{% endif %}

{% if service_name == 'healthreport' %}
# Health report agent. Runs on nuc with network_mode: host, so the
# observability stack is reachable on this host's own interfaces.
HEALTHREPORT_VM_URL=http://{{ hostvars['nuc']['tailscale_ip'] }}:19090
HEALTHREPORT_LOKI_URL=http://{{ hostvars['nuc']['tailscale_ip'] }}:3100
HEALTHREPORT_KUMA_URL=http://{{ hostvars['nuc']['tailscale_ip'] }}:3001
HEALTHREPORT_KUMA_API_KEY={{ secrets.kuma.api_key | default('') }}
HEALTHREPORT_GRAFANA_URL=https://monitor.{{ domain }}
# Consumed by hooks/post-deploy.sh when it writes the systemd timer.
HEALTHREPORT_SCHEDULE={{ healthreport_schedule | default('*-*-* 06:00:00') }}

# Ollama on the NAS. Loaded before the run, explicitly unloaded after.
HEALTHREPORT_OLLAMA_URL=http://{{ hostvars['nas']['tailscale_ip'] }}:11434
HEALTHREPORT_MODEL={{ healthreport_model | default('qwen3:8b') }}
HEALTHREPORT_LLM_ENABLED={{ healthreport_llm_enabled | default(false) | string | lower }}

# Hosts reachable through the facts endpoint. nuc is included even though the
# agent runs there: the script lives on the host, not in the container, so
# there is no local path to execute and nuc would otherwise be the one machine
# the report never inspects.
HEALTHREPORT_SSH_HOSTS=mljr={{ hostvars['mljr']['tailscale_ip'] }},nuc={{ hostvars['nuc']['tailscale_ip'] }},nas={{ hostvars['nas']['tailscale_ip'] }}
HEALTHREPORT_LOCAL_HOST=
HEALTHREPORT_SSH_KEY=/ssh/id_ed25519

HEALTHREPORT_LOOKBACK_HOURS={{ healthreport_lookback_hours | default(24) }}

# Scheduled outages, excluded from traffic-derived findings so planned work is
# not reported as an incident. Local time (TZ above). Syntax:
# "<daily|mon..sun> HH:MM-HH:MM", comma-separated. Set to an empty value to
# disable suppression and see the raw numbers.
# Defaults (see app/config.py): CA docker auto-update on nas at 00:00, and the
# Unraid appdata backup on Sunday 05:00 which stops 13 containers for ~2h45.
HEALTHREPORT_MAINTENANCE_WINDOWS={{ healthreport_maintenance_windows | default('daily 00:00-00:10,sun 04:55-08:00') }}
HEALTHREPORT_5XX_HOUR_THRESHOLD={{ healthreport_5xx_hour_threshold | default(100) }}

# Read-only, account-wide GitHub PAT. Deliberately NOT secrets.github.token,
# which is the GHCR pull credential.
HEALTHREPORT_GITHUB_TOKEN={{ secrets.github_readonly.token | default('') }}
HEALTHREPORT_GITHUB_OWNER={{ secrets.github.username | default('') }}

HEALTHREPORT_NTFY_URL={{ secrets.ntfy.url | default('https://ntfy.mljr.eu') }}
HEALTHREPORT_NTFY_TOPIC={{ secrets.healthreport.ntfy_topic | default('homelab-health') }}
HEALTHREPORT_NTFY_TOKEN={{ secrets.ntfy.token | default('') }}

HEALTHREPORT_SMTP_HOST={{ secrets.smtp.host | default('') }}
HEALTHREPORT_SMTP_PORT={{ secrets.smtp.port | default('587') }}
HEALTHREPORT_SMTP_USER={{ secrets.smtp.user | default('') }}
HEALTHREPORT_SMTP_PASSWORD={{ secrets.smtp.password | default('') }}
HEALTHREPORT_SMTP_FROM={{ secrets.smtp.from | default('notifications@mljr.eu') }}
HEALTHREPORT_EMAIL_TO={{ secrets.healthreport.email_to | default('') }}
{% endif %}
{% endif %}

# ============================================================================
# Docker Configuration
# ============================================================================
IMAGE_TAG={{ image_tag | default('latest') }}
COMPOSE_PROJECT_NAME={{ project_name | default(service_name) }}
