# Auto-generated .env file for {{ service_name }}
# Generated by Ansible at {{ lookup('pipe', 'date -u +%Y-%m-%dT%H:%M:%SZ') }}

# ============================================================================
# Common Settings
# ============================================================================
TZ={{ timezone }}
DOMAIN={{ domain }}
EMAIL={{ email }}

# ============================================================================
# Service-specific Secrets
# ============================================================================
{% if secrets is defined %}
{% if service_name == 'nightscout' %}
# Nightscout
API_SECRET={{ secrets.nightscout.api_secret | default('') }}
NIGHTSCOUT_API_TOKEN={{ secrets.nightscout.api_token | default('') }}
NIGHTSCOUT_DOMAIN={{ secrets.nightscout.domain | default('') }}
# LibreLink
LINK_UP_USERNAME={{ secrets.librelink.username | default('') }}
LINK_UP_PASSWORD={{ secrets.librelink.password | default('') }}
{% endif %}

{% if service_name == 'bichon' %}
# Bichon
BICHON_ENCRYPT_PASSWORD={{ secrets.bichon.encrypt_password | default('') }}
{% endif %}

{% if service_name == 'sudoku' %}
# Sudoku external upload API credentials
SUDOKU_API_USER={{ secrets.sudoku.api_user | default('') }}
SUDOKU_API_PASSWORD={{ secrets.sudoku.api_password | default('') }}
{% endif %}

{% if service_name == 'homepage' %}
# GitHub
GITHUB_USERNAME={{ secrets.github.username | default('') }}
GITHUB_TOKEN={{ secrets.github.token | default('') }}
{% endif %}

{% if service_name == 'kuma' %}
# Uptime Kuma
KUMA_USERNAME={{ secrets.kuma.username | default('') }}
KUMA_PASSWORD={{ secrets.kuma.password | default('') }}
{% endif %}

{% if service_name == 'authelia' %}
# Authelia
AUTHELIA_JWT_SECRET={{ secrets.authelia.jwt_secret | default('') }}
AUTHELIA_SESSION_SECRET={{ secrets.authelia.session_secret | default('') }}
AUTHELIA_STORAGE_ENCRYPTION_KEY={{ secrets.authelia.storage_encryption_key | default('') }}
AUTHELIA_ADMIN_PASSWORD={{ secrets.authelia.admin_password | default('') }}
# SMTP for email notifications
SMTP_HOST={{ secrets.smtp.host | default('') }}
SMTP_PORT={{ secrets.smtp.port | default('587') }}
SMTP_USER={{ secrets.smtp.user | default('') }}
SMTP_PASSWORD={{ secrets.smtp.password | default('') }}
SMTP_FROM={{ secrets.smtp.from | default('authelia@' ~ domain) }}
{% endif %}

{% if service_name == 'keycloak' %}
# Keycloak (deprecated)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD={{ secrets.keycloak.admin_password | default('') }}
KC_DB_PASSWORD={{ secrets.keycloak.db_password | default('') }}
KC_HOSTNAME=auth.{{ domain }}
# Google OAuth for social login
GOOGLE_CLIENT_ID={{ secrets.google.client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ secrets.google.client_secret | default('') }}
{% endif %}

{% if service_name == 'oauth2-proxy' %}
# OAuth2 Proxy
OAUTH2_PROXY_COOKIE_SECRET={{ secrets.oauth2_proxy.cookie_secret | default('') }}
OAUTH2_PROXY_CLIENT_ID={{ secrets.oauth2_proxy.client_id | default('oauth2-proxy') }}
OAUTH2_PROXY_CLIENT_SECRET={{ secrets.oauth2_proxy.client_secret | default('') }}
KEYCLOAK_HOSTNAME=auth.{{ domain }}
KEYCLOAK_REALM=homelab
{% endif %}

{% if service_name == 'sonarqube' %}
# SonarQube
SONARQUBE_DB_PASSWORD={{ secrets.sonarqube.db_password | default('') }}
SONARQUBE_ADMIN_PASSWORD={{ secrets.sonarqube.admin_password | default('admin') }}
{% endif %}

{% if service_name == 'dozzle' %}
# Dozzle - Remote agents (format: name:host:port,name2:host2:port)
DOZZLE_REMOTE_AGENTS={{ secrets.dozzle.remote_agents | default('') }}
{% endif %}

{% if service_name == 'speedtest' %}
# SMTP for speedtest notifications
SMTP_HOST={{ secrets.smtp.host | default('') }}
SMTP_PORT={{ secrets.smtp.port | default('587') }}
SMTP_USER={{ secrets.smtp.user | default('') }}
SMTP_PASSWORD={{ secrets.smtp.password | default('') }}
SMTP_FROM={{ secrets.smtp.from | default('speedtest@' ~ domain) }}
{% endif %}
{% endif %}

# ============================================================================
# Docker Configuration
# ============================================================================
IMAGE_TAG={{ image_tag | default('latest') }}
COMPOSE_PROJECT_NAME={{ project_name | default(service_name) }}

