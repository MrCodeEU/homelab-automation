# Auto-generated .env file for {{ service_name }}
# Generated by Ansible at {{ ansible_date_time.iso8601 }}

# ============================================================================
# Common Settings
# ============================================================================
TZ={{ timezone }}
DOMAIN={{ domain }}
EMAIL={{ email }}

# ============================================================================
# Service-specific Secrets
# ============================================================================
{% if service_name == 'nightscout' %}
# Nightscout
API_SECRET={{ secrets.nightscout.api_secret }}
NIGHTSCOUT_API_TOKEN={{ secrets.nightscout.api_token }}
NIGHTSCOUT_DOMAIN={{ secrets.nightscout.domain }}
# LibreLink
LINK_UP_USERNAME={{ secrets.librelink.username }}
LINK_UP_PASSWORD={{ secrets.librelink.password }}
{% endif %}

{% if service_name == 'bichon' %}
# Bichon
BICHON_ENCRYPT_PASSWORD={{ secrets.bichon.encrypt_password }}
{% endif %}

{% if service_name == 'homepage' %}
# GitHub
GITHUB_USERNAME={{ secrets.github.username }}
GITHUB_TOKEN={{ secrets.github.token }}
{% endif %}

{% if service_name == 'kuma' %}
# Uptime Kuma
KUMA_USERNAME={{ secrets.kuma.username }}
KUMA_PASSWORD={{ secrets.kuma.password }}
{% endif %}

# ============================================================================
# Docker Configuration
# ============================================================================
IMAGE_TAG={{ 'dev' if is_staging | default(false) else 'latest' }}
COMPOSE_PROJECT_NAME={{ service_name }}{% if is_staging | default(false) %}-staging{% endif %}

