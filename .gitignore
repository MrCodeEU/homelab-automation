# Temporary files
*.tmp
*.log
*.swp
*.swo
*~
*.retry

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.sublime-*

# User-specific configurations
inventory.local.yml
configs/caddy/Caddyfile
!configs/caddy/Caddyfile.example

.claude/

# SSH keys (never commit these!)
*.pem
*.key
id_rsa*
id_ed25519
id_ed25519.pub

# Secrets
.env
secrets.env
secrets/
*.secret

# Build artifacts
/tmp/
/dist/
/build/
*.bck.yml

# Frontend build output
apps/homepage/frontend/.svelte-kit/
apps/homepage/frontend/node_modules/
apps/homepage/frontend/build/

# Backend cache
apps/homepage/backend/data/cache/

# Ansible
.ansible/
*.retry
/ansible_facts_cache/

# Git hooks venv
.githooks/.venv/

# This repo's own working copy is itself synced via Syncthing on some
# machines - ignore Syncthing's internal marker files/dirs, not anything
# with "syncthing" in the name (that blocked services/syncthing-ugreen/,
# a real service, until narrowed here).
.stfolder
.stignore
.stversions/

# Misc
package-lock.json

# Local deploy logs
deploy-logs/
check.run
# Added by ggshield
.cache_ggshield

# syncthing sync conflict files
*.sync-conflict-*
# Python bytecode (health report agent, test scripts)
__pycache__/
*.pyc

# Per-host eyaml private keys must never be committed. Public keys are safe to
# commit (encryption-only) and need explicit negations because of *.pem above.
!openvox/keys/*/
!openvox/keys/*/public_key.pkcs7.pem

# Host-specific eyaml ciphertext is public-by-design, while generated
# private keys stay ignored by the blanket *.pem rule above.
!openvox/data/secrets/
!openvox/data/secrets/.gitkeep
!openvox/data/secrets/*.eyaml

# Downloaded only by the pinned VoxBox catalog-test container. Keep the empty
# mountpoint tracked so the read-only integration runner can overlay it.
openvox/spec/fixtures/modules/*
!openvox/spec/fixtures/modules/.gitkeep
tools/bin/

# canary-gen's default output: real decoy files + auth_token per created
# Canarytoken (deletes/edits that token if leaked) - local staging only,
# never committed.
canary-out/
