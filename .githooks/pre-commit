#!/bin/bash
# Pre-commit hook for homelab-automation
# Validates service configurations before allowing commits

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the root of the git repository
REPO_ROOT=$(git rev-parse --show-toplevel)

echo -e "${YELLOW}Running pre-commit validations...${NC}"

# Guard: common.eyaml's secret values must never be committed unencrypted.
# Every non-blank, non-comment line must carry an ENC[PKCS7,...] value.
EYAML_FILE="openvox/data/common.eyaml"
if git diff --cached --name-only | grep -qx "$EYAML_FILE"; then
    EYAML_CONTENT=$(git show ":$EYAML_FILE" 2>/dev/null)
    if [ -z "$EYAML_CONTENT" ]; then
        echo -e "${RED}✗ common.eyaml is staged but empty or unreadable!${NC}"
        exit 1
    fi
    PLAINTEXT_LINES=$(echo "$EYAML_CONTENT" | grep -vE '^\s*(#.*)?$' | grep -vF 'ENC[PKCS7' || true)
    if [ -n "$PLAINTEXT_LINES" ]; then
        echo -e "${RED}✗ common.eyaml has unencrypted value(s)! Aborting commit.${NC}"
        echo -e "${RED}  Encrypt with: eyaml encrypt -l <label> -s '<value>' --pkcs7-public-key=...${NC}"
        echo "$PLAINTEXT_LINES"
        exit 1
    fi
    echo -e "${GREEN}✓ common.eyaml is encrypted${NC}"
fi

# Run service definition validation (ports, domains, uniqueness, etc.)
if ! (cd "$REPO_ROOT/tools" && go run ./cmd/validate-services); then
    echo -e "${RED}✗ Service validation failed!${NC}"
    exit 1
fi

if ! "$REPO_ROOT/scripts/sync-openvox-service-files.sh" check; then
    echo -e "${RED}✗ OpenVox service assets are out of sync!${NC}"
    echo -e "${RED}  Run: make sync-openvox-services${NC}"
    exit 1
fi

echo -e "${GREEN}✓ All pre-commit validations passed!${NC}"
exit 0
