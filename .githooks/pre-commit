#!/bin/bash
# Pre-commit hook for homelab-automation
# Validates service configurations before allowing commits

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the root of the git repository
REPO_ROOT=$(git rev-parse --show-toplevel)

echo -e "${YELLOW}Running pre-commit validations...${NC}"

# Guard: vault.yml must never be committed unencrypted
VAULT_FILE="$REPO_ROOT/ansible/inventory/group_vars/all/vault.yml"
if git diff --cached --name-only | grep -qx "ansible/inventory/group_vars/all/vault.yml"; then
    VAULT_HEADER=$(git show ":ansible/inventory/group_vars/all/vault.yml" 2>/dev/null | head -1)
    if [ -z "$VAULT_HEADER" ]; then
        echo -e "${RED}✗ vault.yml is staged but empty or unreadable!${NC}"
        exit 1
    fi
    if [[ "$VAULT_HEADER" != '$ANSIBLE_VAULT'* ]]; then
        echo -e "${RED}✗ vault.yml is NOT encrypted! Aborting commit.${NC}"
        echo -e "${RED}  Run: ansible-vault encrypt $VAULT_FILE${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ vault.yml is encrypted${NC}"
fi

# Run service definition validation (ports, domains, uniqueness, etc.)
echo -e "${YELLOW}Validating service configurations...${NC}"
if ! python3 "$REPO_ROOT/.githooks/validate_services.py"; then
    echo -e "${RED}✗ Service validation failed!${NC}"
    exit 1
fi

echo -e "${GREEN}✓ All pre-commit validations passed!${NC}"
exit 0
