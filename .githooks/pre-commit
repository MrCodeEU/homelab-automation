#!/bin/bash
# Pre-commit hook for homelab-automation
# Validates service configurations before allowing commits

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the root of the git repository
REPO_ROOT=$(git rev-parse --show-toplevel)
VENV_DIR="$REPO_ROOT/.githooks/.venv"
REQUIREMENTS="pyyaml"

# Create virtual environment if it doesn't exist
if [ ! -d "$VENV_DIR" ]; then
    echo -e "${YELLOW}Setting up validation environment...${NC}"
    python3 -m venv "$VENV_DIR"
    source "$VENV_DIR/bin/activate"
    pip install --quiet --upgrade pip
    pip install --quiet $REQUIREMENTS
    echo -e "${GREEN}✓ Environment ready${NC}"
else
    source "$VENV_DIR/bin/activate"
fi

echo -e "${YELLOW}Running pre-commit validations...${NC}"

# Run the Python validation script
if ! python "$REPO_ROOT/.githooks/validate_services.py"; then
    echo -e "${RED}✗ Pre-commit validation failed!${NC}"
    echo -e "${RED}Please fix the errors above before committing.${NC}"
    deactivate 2>/dev/null || true
    exit 1
fi

deactivate 2>/dev/null || true
echo -e "${GREEN}✓ All pre-commit validations passed!${NC}"
exit 0
