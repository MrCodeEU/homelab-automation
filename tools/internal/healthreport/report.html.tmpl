<style>
  :root { color-scheme: light dark; }
  @media (prefers-color-scheme: dark) {
    .hr-surface { background:#1a1a19 !important; }
    .hr-card    { background:#242423 !important; border-color:#3a3a38 !important; }
    .hr-ink     { color:#ffffff !important; }
    .hr-ink-2   { color:#c3c2b7 !important; }
    .hr-rule    { border-color:#3a3a38 !important; }
    .hr-track   { background:#3a3a38 !important; }
  }
</style>
<div class="hr-surface" style="background:#fcfcfb;padding:20px 12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="max-width:680px;margin:0 auto;width:100%;">

  <tr><td>
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;letter-spacing:.08em;text-transform:uppercase;">Homelab health</div>
    <div class="hr-ink" style="color:#0b0b0b;font-size:22px;font-weight:600;line-height:1.3;margin:2px 0 0;">{{ .Headline }}</div>
    <div class="hr-ink-2" style="color:#52514e;font-size:13px;margin-top:6px;">{{ .RunDate }} · {{ .RunHost }} · {{ .ObservationCount }} observations</div>
  </td></tr>

  <tr><td style="padding-top:18px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:8px 0;">
      <tr>
        {{ range .Tiles }}
        <td class="hr-card" width="25%" style="background:#ffffff;border:1px solid #e6e5e1;border-radius:8px;padding:10px 12px;text-align:left;">
          <div style="font-size:24px;font-weight:700;line-height:1.1;color:{{ .Color }};">{{ .Value }}</div>
          <div class="hr-ink-2" style="color:#52514e;font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-top:2px;">{{ .Label }}</div>
        </td>
        {{ end }}
      </tr>
    </table>
  </td></tr>

  {{ if .HasNarrative }}
  <tr><td style="padding-top:18px;">
    <div class="hr-card" style="background:#ffffff;border:1px solid #e6e5e1;border-radius:8px;padding:14px 16px;">
      <div class="hr-ink" style="color:#0b0b0b;font-size:14px;line-height:1.55;">{{ .Assessment }}</div>
    </div>
  </td></tr>
  {{ end }}

  {{ if gt (len .Trend) 1 }}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;">Findings over time</div>
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;margin:2px 0 10px;">
      <span style="display:inline-block;width:9px;height:9px;background:#d03b3b;border-radius:2px;"></span> Critical
      &nbsp;&nbsp;<span style="display:inline-block;width:9px;height:9px;background:#fab219;border-radius:2px;"></span> Warning
    </div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:3px 0;">
      <tr>
        {{ range .Trend }}
        <td valign="bottom" style="height:90px;vertical-align:bottom;">
          <div style="font-size:10px;color:#52514e;text-align:center;line-height:1.2;">{{ .Total }}</div>
          {{ if .HasWarn }}<div style="height:{{ .WarnHeight }}px;background:#fab219;border-radius:4px 4px 0 0;margin-bottom:2px;"></div>{{ end }}
          {{ if .HasCrit }}<div style="height:{{ .CritHeight }}px;background:#d03b3b;border-radius:4px 4px 0 0;"></div>{{ end }}
          {{ if not .Total }}<div class="hr-track" style="height:2px;background:#e6e5e1;border-radius:2px;"></div>{{ end }}
        </td>
        {{ end }}
      </tr>
      <tr>
        {{ range .Trend }}
        <td class="hr-ink-2" style="color:#52514e;font-size:9px;text-align:center;padding-top:4px;">{{ .Date }}</td>
        {{ end }}
      </tr>
    </table>
  </td></tr>
  {{ end }}

  {{ if .ByHost }}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:10px;">Where the trouble is</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
      {{ range .ByHost }}
      <tr>
        <td class="hr-ink" style="color:#0b0b0b;font-size:13px;padding:3px 8px 3px 0;white-space:nowrap;width:1%;">{{ .Subject }}</td>
        <td style="padding:3px 0;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:2px 0;">
            <tr>
              {{ if .Crit }}<td style="width:{{ .CritPct }}%;background:#d03b3b;border-radius:4px;height:14px;"></td>{{ end }}
              {{ if .Warn }}<td style="width:{{ .WarnPct }}%;background:#fab219;border-radius:4px;height:14px;"></td>{{ end }}
            </tr>
          </table>
        </td>
        <td class="hr-ink-2" style="color:#52514e;font-size:12px;padding:3px 0 3px 8px;white-space:nowrap;width:1%;">{{ .CritText }}</td>
      </tr>
      {{ end }}
    </table>
  </td></tr>
  {{ end }}

  {{ if .TopIssues }}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:8px;">What to look at first</div>
    {{ range .TopIssues }}
    <div class="hr-card" style="background:#ffffff;border:1px solid #e6e5e1;border-radius:8px;padding:10px 12px;margin-bottom:6px;">
      <div class="hr-ink" style="color:#0b0b0b;font-size:13px;font-weight:600;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{{ .ObservationID }}</div>
      <div class="hr-ink-2" style="color:#52514e;font-size:13px;line-height:1.5;margin-top:3px;">{{ .WhyItMatters }}</div>
    </div>
    {{ end }}
    {{ if .SuggestedActions }}
    <div class="hr-ink-2" style="color:#52514e;font-size:13px;line-height:1.6;margin-top:8px;">
      {{ range .SuggestedActions }}▸ {{ . }}<br>{{ end }}
    </div>
    {{ end }}
  </td></tr>
  {{ end }}

  {{ if .HasStateHosts }}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:10px;">System state</div>

    {{ if .StateCounts }}
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;margin-bottom:10px;">
      {{ range $i, $c := .StateCounts }}{{ if $i }} · {{ end }}{{ $c.Label }} <span class="hr-ink" style="color:#0b0b0b;font-weight:600;">{{ $c.Value }}</span>{{ end }}
    </div>
    {{ end }}

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
      {{ range .StateHosts }}
      <tr>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 8px 7px 0;vertical-align:top;width:1%;white-space:nowrap;">
          <span class="hr-ink" style="color:#0b0b0b;font-size:13px;font-weight:600;">{{ .Name }}</span>
          <div class="hr-ink-2" style="color:#52514e;font-size:11px;">up {{ .Uptime }}</div>
        </td>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 0;vertical-align:top;">
          <div class="hr-ink-2" style="color:#52514e;font-size:12px;margin-bottom:4px;">
            memory {{ .MemoryLabel }}% · load/core {{ .LoadLabel }}
          </div>
          {{ range .Filesystems }}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:2px;">
            <tr>
              <td class="hr-ink-2" style="color:#52514e;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding-right:8px;white-space:nowrap;width:1%;">{{ .Mountpoint }}</td>
              <td style="padding-right:8px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;">
                  <tr><td style="background:#e6e5e1;border-radius:3px;height:8px;padding:0;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:{{ .UsedPercent }}%;">
                      <tr><td style="background:{{ .BarColor }};border-radius:3px;height:8px;"></td></tr>
                    </table>
                  </td></tr>
                </table>
              </td>
              <td class="hr-ink-2" style="color:#52514e;font-size:11px;white-space:nowrap;width:1%;">{{ .UsedPercent }}%</td>
            </tr>
          </table>
          {{ end }}
        </td>
      </tr>
      {{ end }}
    </table>

    {{ if .BackupTargets }}
    <div class="hr-ink" style="color:#0b0b0b;font-size:12px;font-weight:600;margin-top:12px;margin-bottom:4px;">Backup destinations</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
      {{ range .BackupTargets }}
      <tr>
        <td class="hr-ink-2" style="color:#52514e;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding:3px 8px 3px 0;white-space:nowrap;width:1%;">{{ .Name }}</td>
        <td style="padding:3px 8px 3px 0;">
          {{ if .HasPercent }}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;">
            <tr><td style="background:#e6e5e1;border-radius:3px;height:8px;padding:0;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:{{ .UsedPercent }}%;">
                <tr><td style="background:{{ .BarColor }};border-radius:3px;height:8px;"></td></tr>
              </table>
            </td></tr>
          </table>
          {{ end }}
        </td>
        <td class="hr-ink-2" style="color:#52514e;font-size:11px;white-space:nowrap;width:1%;">{{ .Detail }}</td>
      </tr>
      {{ end }}
    </table>
    {{ end }}

    {{ if .Notes }}
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;line-height:1.7;margin-top:8px;">
      {{ range .Notes }}· {{ . }}<br>{{ end }}
    </div>
    {{ end }}
  </td></tr>
  {{ end }}

  {{ range .Sections }}
  {{ if .Rows }}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:8px;">{{ .Title }}</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
      {{ range .Rows }}
      <tr>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 8px 7px 0;vertical-align:top;width:1%;white-space:nowrap;">
          <span style="display:inline-block;font-size:10px;font-weight:700;letter-spacing:.04em;padding:2px 6px;border-radius:4px;color:#ffffff;background:{{ .SeverityColor }};">
            {{ .Severity }}
          </span>
        </td>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 0;vertical-align:top;">
          <div class="hr-ink" style="color:#0b0b0b;font-size:13px;line-height:1.45;">{{ .Message }}</div>
          <div class="hr-ink-2" style="color:#52514e;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;margin-top:2px;">
            {{ .ID }}{{ if and .FirstSeenDate .ShowAge }} · since {{ .FirstSeenDate }}{{ end }}
          </div>
        </td>
      </tr>
      {{ end }}
    </table>
  </td></tr>
  {{ end }}
  {{ end }}

  {{ if .Resolved }}
  <tr><td style="padding-top:18px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:6px;">Resolved since last run ({{ len .Resolved }})</div>
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;line-height:1.7;">
      {{ range .Resolved }}✓ {{ . }}<br>{{ end }}
    </div>
  </td></tr>
  {{ end }}

  {{ if .CollectorsFailed }}
  <tr><td style="padding-top:18px;">
    <div style="border-left:3px solid #d03b3b;padding:2px 0 2px 10px;">
      <div class="hr-ink" style="color:#0b0b0b;font-size:13px;font-weight:600;">This report is incomplete</div>
      <div class="hr-ink-2" style="color:#52514e;font-size:12px;line-height:1.5;margin-top:2px;">
        {{ range .CollectorsFailed }}{{ .Name }} — {{ .Error }}<br>{{ end }}
      </div>
    </div>
  </td></tr>
  {{ end }}

  <tr><td class="hr-rule" style="padding-top:20px;border-top:1px solid #e6e5e1;margin-top:16px;">
    <div class="hr-ink-2" style="color:#52514e;font-size:11px;line-height:1.6;padding-top:12px;">
      Run {{ .RunID }} · LLM {{ .LLMStatus }} · {{ .CollectorCount }} collectors ·
      severity from rules.yml, not from the model · full data attached as facts.json
    </div>
  </td></tr>

</table>
</div>
