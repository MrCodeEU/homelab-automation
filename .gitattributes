# Auto-detect text files and normalize to LF
* text=auto

# Force LF line endings for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Force LF for configuration files
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
