# Trivial pass-through build so this participates in the same
# build_from_source: true / --build path as the collector image (see
# docker-compose.yml's comment on the web service). The deploy pipeline's
# image-pull step is skipped entirely for build_from_source services -
# skipping it while still referencing a bare `image: nginx:...` here meant
# nginx was never pulled and the web container never got created (confirmed
# live: docker compose ps showed nothing at all for it after a real deploy).
# A one-line FROM makes `docker compose build` resolve/pull the base image
# as a normal build step instead, which the pipeline does invoke.
FROM nginx:1.27-alpine
