# Nocturne - Diabetes Management Platform
# Generated by OpenVox. Edit openvox/data/common.eyaml to change secrets.

# ============================================================================
# Required — set in vault before first run
# ============================================================================

# Externally accessible hostname (no https://)
BASE_DOMAIN=nocturne.mljr.eu

# Random secret shared between web and API containers
# Generate: openssl rand -hex 32
INSTANCE_KEY=

# PostgreSQL superuser credentials (first-run init only)
POSTGRES_USERNAME=nocturne
POSTGRES_PASSWORD=

# PostgreSQL role passwords (set once on DB init, do not change after)
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_WEB_PASSWORD=

# ============================================================================
# Images
# ============================================================================
NOCTURNE_API_IMAGE=ghcr.io/nightscout/nocturne/nocturne-api:latest
NOCTURNE_API_PORT=8082
NOCTURNE_WEB_IMAGE=ghcr.io/nightscout/nocturne/nocturne-web:latest

# ============================================================================
# Docker
# ============================================================================
COMPOSE_PROJECT_NAME=nocturne
