// Grafana Alloy configuration for the Unraid NAS.
// Deployed by ansible/roles/services via the unraid play in playbooks/site.yml.
// Labels are fixed to "nas" so the provisioned dashboards pick it up.
//
// Kept as a static file rather than a template because the values never vary
// per-host: there is exactly one Unraid box.

prometheus.exporter.unix "host" {
  rootfs_path = "/hostfs"
  procfs_path = "/hostfs/proc"
  sysfs_path  = "/hostfs/sys"

  // No systemd collector here: Unraid is Slackware and does not run systemd.
}

prometheus.scrape "host" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.relabel.identity.receiver]
  job_name   = "node"
}

prometheus.exporter.cadvisor "docker" {
  docker_host      = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}

prometheus.scrape "docker" {
  targets    = prometheus.exporter.cadvisor.docker.targets
  forward_to = [prometheus.relabel.identity.receiver]
  job_name   = "docker"
}

// prometheus.scrape attaches its own `instance` label from the scrape target,
// which wins over remote_write's external_labels. Rewrite it here so the NAS
// reports as "nas" rather than its DNS name.
prometheus.relabel "identity" {
  forward_to = [prometheus.remote_write.homelab.receiver]

  rule {
    target_label = "instance"
    replacement  = "nas"
  }

  rule {
    target_label = "host"
    replacement  = "nas"
  }
}

prometheus.remote_write "homelab" {
  endpoint {
    url = "http://100.100.10.1:19090/api/v1/write"
  }

  external_labels = {
    instance = "nas",
    host     = "nas",
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// The static `labels` block below replaces discovery's labels wholesale, so
// promote the container name first or every log line arrives unattributable.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = {
    job      = "docker",
    instance = "nas",
    host     = "nas",
  }
  forward_to = [loki.process.recent.receiver]
}

// Matches the rocky hosts: drop anything older than the Loki retention window
// so a container replaying old logs cannot flood the ingester.
loki.process "recent" {
  forward_to = [loki.write.homelab.receiver]

  stage.drop {
    older_than          = "168h"
    drop_counter_reason = "too_old"
  }
}

loki.source.file "system_logs" {
  targets = [
    {
      // Slackware/Unraid path. Rocky hosts use /var/log/messages.
      "__path__" = "/var/log/syslog",
      "job"      = "system",
      "instance" = "nas",
      "host"     = "nas",
    },
  ]
  forward_to = [loki.process.recent.receiver]

  file_match {
    enabled = true
  }
}

loki.write "homelab" {
  endpoint {
    url = "http://100.100.10.1:3100/loki/api/v1/push"
  }
}
