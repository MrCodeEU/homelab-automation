# AppSec proof of concept (docs/APPSEC_POC_PLAN.md). Two listeners, same
# build: :8444 runs every request through AppSec, :8445 is the baseline
# without it. Both only proxy to a static echo container.
{
	admin off
	auto_https off

	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_BOUNCER_KEY}
		ticker_interval 15s
		appsec_url http://crowdsec:7422
		# A hung or stopped AppSec must never take a site down. Bare flag: the
		# parser takes no argument (the upstream README is wrong about this).
		appsec_fail_open
		# 1 MiB: larger bodies are not buffered for inspection.
		appsec_max_body_bytes 1048576
		appsec_timeout 2s
	}
}

:8444 {
	log {
		output stdout
		format json
	}
	route {
		appsec
		reverse_proxy whoami:80
	}
}

:8445 {
	reverse_proxy whoami:80
}

# Container healthcheck target (Dockerfile HEALTHCHECK), loopback only.
http://127.0.0.1:8446 {
	respond "ok"
}
