{#-
  HTML part of the daily report.

  Email constraints drive every choice here:
  - no JavaScript, so no hover layer; the static form must carry everything
  - no external resources; no SVG (several clients strip it)
  - charts are table cells with background-color and percentage widths, which
    is the one charting technique that renders everywhere
  - styles are inlined on elements; the <style> block carries only the dark
    mode media query, which cannot be inlined

  Severity uses the reserved status palette (critical/warning/good). On a light
  surface `warning` is sub-3:1 by design, so the relief rule applies: every
  segment carries a visible number and the full findings table is present.
  Colour never carries meaning alone.
-#}
{% macro bar(crit, warn, total, width_pct) -%}
{%- set denom = total if total > 0 else 1 -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:{{ width_pct }}%;border-collapse:separate;border-spacing:2px 0;">
  <tr>
    {% if crit %}<td style="width:{{ (crit / denom * 100) | round(1) }}%;background:#d03b3b;border-radius:4px;height:14px;"></td>{% endif %}
    {% if warn %}<td style="width:{{ (warn / denom * 100) | round(1) }}%;background:#fab219;border-radius:4px;height:14px;"></td>{% endif %}
  </tr>
</table>
{%- endmacro %}
<style>
  :root { color-scheme: light dark; }
  @media (prefers-color-scheme: dark) {
    .hr-surface { background:#1a1a19 !important; }
    .hr-card    { background:#242423 !important; border-color:#3a3a38 !important; }
    .hr-ink     { color:#ffffff !important; }
    .hr-ink-2   { color:#c3c2b7 !important; }
    .hr-rule    { border-color:#3a3a38 !important; }
    .hr-track   { background:#3a3a38 !important; }
  }
</style>
<div class="hr-surface" style="background:#fcfcfb;padding:20px 12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="max-width:680px;margin:0 auto;width:100%;">

  <tr><td>
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;letter-spacing:.08em;text-transform:uppercase;">Homelab health</div>
    <div class="hr-ink" style="color:#0b0b0b;font-size:22px;font-weight:600;line-height:1.3;margin:2px 0 0;">{{ headline }}</div>
    <div class="hr-ink-2" style="color:#52514e;font-size:13px;margin-top:6px;">{{ facts.run.id[:10] }} · {{ facts.run.host }} · {{ facts.observations | length }} observations</div>
  </td></tr>

  {# ---- hero counts: a number is the right form for a single magnitude ---- #}
  <tr><td style="padding-top:18px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:8px 0;">
      <tr>
        {% for tile in tiles %}
        <td class="hr-card" width="25%" style="background:#ffffff;border:1px solid #e6e5e1;border-radius:8px;padding:10px 12px;text-align:left;">
          <div style="font-size:24px;font-weight:700;line-height:1.1;color:{{ tile.color }};">{{ tile.value }}</div>
          <div class="hr-ink-2" style="color:#52514e;font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-top:2px;">{{ tile.label }}</div>
        </td>
        {% endfor %}
      </tr>
    </table>
  </td></tr>

  {% if narrative %}
  <tr><td style="padding-top:18px;">
    <div class="hr-card" style="background:#ffffff;border:1px solid #e6e5e1;border-radius:8px;padding:14px 16px;">
      <div class="hr-ink" style="color:#0b0b0b;font-size:14px;line-height:1.55;">{{ narrative.assessment }}</div>
    </div>
  </td></tr>
  {% endif %}

  {# ---- trend: change over time, two series, legend + labels ---- #}
  {% if trend | length > 1 %}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;">Findings over time</div>
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;margin:2px 0 10px;">
      <span style="display:inline-block;width:9px;height:9px;background:#d03b3b;border-radius:2px;"></span> Critical
      &nbsp;&nbsp;<span style="display:inline-block;width:9px;height:9px;background:#fab219;border-radius:2px;"></span> Warning
    </div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:3px 0;">
      <tr>
        {% for point in trend %}
        {% set total = point.crit + point.warn %}
        <td valign="bottom" style="height:{{ trend_height }}px;vertical-align:bottom;">
          <div style="font-size:10px;color:#52514e;text-align:center;line-height:1.2;">{{ total }}</div>
          {% if point.warn %}<div style="height:{{ (point.warn / trend_max * (trend_height - 18)) | round | int }}px;background:#fab219;border-radius:4px 4px 0 0;margin-bottom:2px;"></div>{% endif %}
          {% if point.crit %}<div style="height:{{ (point.crit / trend_max * (trend_height - 18)) | round | int }}px;background:#d03b3b;border-radius:4px 4px 0 0;"></div>{% endif %}
          {% if not total %}<div class="hr-track" style="height:2px;background:#e6e5e1;border-radius:2px;"></div>{% endif %}
        </td>
        {% endfor %}
      </tr>
      <tr>
        {% for point in trend %}
        <td class="hr-ink-2" style="color:#52514e;font-size:9px;text-align:center;padding-top:4px;">{{ point.date }}</td>
        {% endfor %}
      </tr>
    </table>
  </td></tr>
  {% endif %}

  {# ---- magnitude by category, worst first ---- #}
  {% if by_host %}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:10px;">Where the trouble is</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
      {% for row in by_host[:8] %}
      <tr>
        <td class="hr-ink" style="color:#0b0b0b;font-size:13px;padding:3px 8px 3px 0;white-space:nowrap;width:1%;">{{ row.subject }}</td>
        <td style="padding:3px 0;">{{ bar(row.crit, row.warn, host_max, (row.total / host_max * 100) | round(1)) }}</td>
        <td class="hr-ink-2" style="color:#52514e;font-size:12px;padding:3px 0 3px 8px;white-space:nowrap;width:1%;">
          {% if row.crit %}{{ row.crit }} crit{% endif %}{% if row.crit and row.warn %}, {% endif %}{% if row.warn %}{{ row.warn }} warn{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endif %}

  {% if narrative and narrative.top_issues %}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:8px;">What to look at first</div>
    {% for issue in narrative.top_issues %}
    <div class="hr-card" style="background:#ffffff;border:1px solid #e6e5e1;border-radius:8px;padding:10px 12px;margin-bottom:6px;">
      <div class="hr-ink" style="color:#0b0b0b;font-size:13px;font-weight:600;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{{ issue.observation_id }}</div>
      <div class="hr-ink-2" style="color:#52514e;font-size:13px;line-height:1.5;margin-top:3px;">{{ issue.why_it_matters }}</div>
    </div>
    {% endfor %}
    {% if narrative.suggested_actions %}
    <div class="hr-ink-2" style="color:#52514e;font-size:13px;line-height:1.6;margin-top:8px;">
      {% for action in narrative.suggested_actions %}▸ {{ action }}<br>{% endfor %}
    </div>
    {% endif %}
  </td></tr>
  {% endif %}

  {# ---- system state: what the estate looks like when nothing is wrong ----
       A quiet day used to produce an almost empty email, which told you
       nothing - not whether disks were filling, not that a token expires
       soon. None of this is newly collected; it is the same numbers the
       threshold rules already read. ---- #}
  {% if state and state.hosts %}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:10px;">System state</div>

    {% if state.counts %}
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;margin-bottom:10px;">
      {% for c in state.counts %}{{ c.label }} <span class="hr-ink" style="color:#0b0b0b;font-weight:600;">{{ c.value }}</span>{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
    {% endif %}

    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
      {% for h in state.hosts %}
      <tr>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 8px 7px 0;vertical-align:top;width:1%;white-space:nowrap;">
          <span class="hr-ink" style="color:#0b0b0b;font-size:13px;font-weight:600;">{{ h.name }}</span>
          <div class="hr-ink-2" style="color:#52514e;font-size:11px;">up {{ h.uptime }}</div>
        </td>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 0;vertical-align:top;">
          <div class="hr-ink-2" style="color:#52514e;font-size:12px;margin-bottom:4px;">
            memory {{ h.memory_percent | round(1) if h.memory_percent is not none else '?' }}% ·
            load/core {{ h.load_per_core if h.load_per_core is not none else '?' }}
          </div>
          {% for m in h.filesystems %}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin-bottom:2px;">
            <tr>
              <td class="hr-ink-2" style="color:#52514e;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding-right:8px;white-space:nowrap;width:1%;">{{ m.mountpoint }}</td>
              <td style="padding-right:8px;">
                {# Bar is decorative; the number beside it always carries the value. #}
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;">
                  <tr><td style="background:#e6e5e1;border-radius:3px;height:8px;padding:0;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:{{ m.used_percent | round(0) }}%;">
                      <tr><td style="background:{{ '#d03b3b' if m.used_percent >= 85 else ('#fab219' if m.used_percent >= 70 else '#0ca30c') }};border-radius:3px;height:8px;"></td></tr>
                    </table>
                  </td></tr>
                </table>
              </td>
              <td class="hr-ink-2" style="color:#52514e;font-size:11px;white-space:nowrap;width:1%;">{{ m.used_percent | round(1) }}%</td>
            </tr>
          </table>
          {% endfor %}
        </td>
      </tr>
      {% endfor %}
    </table>

    {% if state.backup_targets %}
    <div class="hr-ink" style="color:#0b0b0b;font-size:12px;font-weight:600;margin-top:12px;margin-bottom:4px;">Backup destinations</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
      {% for t in state.backup_targets %}
      <tr>
        <td class="hr-ink-2" style="color:#52514e;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;padding:3px 8px 3px 0;white-space:nowrap;width:1%;">{{ t.name }}</td>
        <td style="padding:3px 8px 3px 0;">
          {% if t.used_percent is not none %}
          <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;">
            <tr><td style="background:#e6e5e1;border-radius:3px;height:8px;padding:0;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:{{ t.used_percent | round(0) }}%;">
                <tr><td style="background:{{ '#d03b3b' if t.used_percent >= 93 else ('#fab219' if t.used_percent >= 85 else '#0ca30c') }};border-radius:3px;height:8px;"></td></tr>
              </table>
            </td></tr>
          </table>
          {% endif %}
        </td>
        <td class="hr-ink-2" style="color:#52514e;font-size:11px;white-space:nowrap;width:1%;">
          {% if t.used_percent is not none %}{{ t.used_percent | round(1) }}% · {{ t.free_gib }} GiB free{% else %}{{ t.note or 'unknown' }}{% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
    {% endif %}

    {% if state.notes %}
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;line-height:1.7;margin-top:8px;">
      {% for note in state.notes %}· {{ note }}<br>{% endfor %}
    </div>
    {% endif %}
  </td></tr>
  {% endif %}

  {# ---- the table view: identity never rests on colour ---- #}
  {% for section in sections %}
  {% if section.rows %}
  <tr><td style="padding-top:22px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:8px;">{{ section.title }} ({{ section.rows | length }})</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
      {% for obs in section.rows %}
      <tr>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 8px 7px 0;vertical-align:top;width:1%;white-space:nowrap;">
          <span style="display:inline-block;font-size:10px;font-weight:700;letter-spacing:.04em;padding:2px 6px;border-radius:4px;color:#ffffff;background:{{ '#d03b3b' if obs.severity == 'crit' else ('#fab219' if obs.severity == 'warn' else '#0ca30c') }};">
            {{ obs.severity | upper }}
          </span>
        </td>
        <td class="hr-rule" style="border-top:1px solid #e6e5e1;padding:7px 0;vertical-align:top;">
          <div class="hr-ink" style="color:#0b0b0b;font-size:13px;line-height:1.45;">{{ obs.message }}</div>
          <div class="hr-ink-2" style="color:#52514e;font-size:11px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;margin-top:2px;">
            {{ obs.id }}{% if obs.first_seen and section.show_age %} · since {{ obs.first_seen[:10] }}{% endif %}
          </div>
        </td>
      </tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endif %}
  {% endfor %}

  {% if facts.diff.resolved %}
  <tr><td style="padding-top:18px;">
    <div class="hr-ink" style="color:#0b0b0b;font-size:14px;font-weight:600;margin-bottom:6px;">Resolved since last run ({{ facts.diff.resolved | length }})</div>
    <div class="hr-ink-2" style="color:#52514e;font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;line-height:1.7;">
      {% for id in facts.diff.resolved %}✓ {{ id }}<br>{% endfor %}
    </div>
  </td></tr>
  {% endif %}

  {% if facts.summary.collectors_failed %}
  <tr><td style="padding-top:18px;">
    <div style="border-left:3px solid #d03b3b;padding:2px 0 2px 10px;">
      <div class="hr-ink" style="color:#0b0b0b;font-size:13px;font-weight:600;">This report is incomplete</div>
      <div class="hr-ink-2" style="color:#52514e;font-size:12px;line-height:1.5;margin-top:2px;">
        {% for name in facts.summary.collectors_failed %}{{ name }} — {{ facts.collectors[name].error }}<br>{% endfor %}
      </div>
    </div>
  </td></tr>
  {% endif %}

  <tr><td class="hr-rule" style="padding-top:20px;border-top:1px solid #e6e5e1;margin-top:16px;">
    <div class="hr-ink-2" style="color:#52514e;font-size:11px;line-height:1.6;padding-top:12px;">
      Run {{ facts.run.id }} · LLM {{ facts.llm_status }} · {{ facts.collectors | length }} collectors ·
      severity from rules.yml, not from the model · full data attached as facts.json
    </div>
  </td></tr>

</table>
</div>
