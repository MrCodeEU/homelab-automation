{
  "uid": "homelab-crowdsec",
  "title": "CrowdSec",
  "tags": ["homelab", "security", "crowdsec"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Ban Decisions (total)",
      "description": "Includes CAPI's community blocklist, which normally dwarfs local decisions - see the by-origin panel below for the locally-relevant number.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(cs_active_decisions)"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Local Decisions (crowdsec origin only)",
      "description": "Excludes CAPI - this is what this box's own detection actually caught.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 50}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(cs_active_decisions{origin=\"crowdsec\"})"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alerts (24h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(increase(cs_alerts[24h]))"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bucket Overflows (24h)",
      "description": "A scenario tripped and escalated to a ban - the actual 'something attacked us' signal.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(increase(cs_bucket_overflowed_total[24h]))"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active Decisions by Origin",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by(origin) (cs_active_decisions)", "legendFormat": "{{origin}}"}]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top Ban Reasons (local decisions)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []},
      "options": {"showHeader": true, "sortBy": [{"displayName": "Value", "desc": true}]},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "host": true, "action": true, "origin": true}, "renameByName": {"reason": "Scenario", "Value": "Count"}}}],
      "targets": [{"refId": "A", "expr": "cs_active_decisions{origin=\"crowdsec\"}", "format": "table", "instant": true}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Alert Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "increase(cs_alerts[1h])", "legendFormat": "{{reason}}"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bucket Overflow Rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "fillOpacity": 60, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "increase(cs_bucket_overflowed_total[1h])", "legendFormat": "{{name}}"}]
    }
  ]
}
