# OpenZiti tunneler for the laptop (Fedora Atomic), docs/ZERO_TRUST_PLAN.md
# C8. A root Quadlet: no rpm-ostree layering, /etc and /var survive updates.
# Installed by scripts/ziti-laptop-tunnel.sh to
# /etc/containers/systemd/ziti-edge-tunnel.container.
#
# - Host network + /dev/net/tun + NET_ADMIN: the tunneler creates its ziti0
#   tun interface and routes in the host namespace.
# - The D-Bus socket lets it register its DNS on ziti0 with systemd-resolved.
#   SELinux labelling is off for this container only, because the socket's
#   label cannot be shared with a container otherwise.
# - --dns-ip-range: the default 100.64.0.1/10 overlaps Tailscale's CGNAT
#   addresses; 198.18.0.0/16 (RFC 2544 benchmarking) does not. Its first
#   address is the tunneler's DNS server.
# - Identities: every *.json in /var/lib/ziti-edge-tunnel (the entrypoint
#   runs with --identity-dir when ZITI_IDENTITY_BASENAME is unset). Needed
#   for `ziti-edge-tunnel add` (enrolment through Authelia, C15), which
#   refuses without an identity dir. scripts/ziti-laptop-tunnel.sh enrols
#   laptop-mrcode.jwt itself, since the entrypoint ignores tokens in this
#   mode.
[Unit]
Description=OpenZiti tunneler (ziti-edge-tunnel)
Wants=network-online.target
After=network-online.target systemd-resolved.service

[Container]
# 1.18.7.2, the latest non-prerelease
Image=docker.io/openziti/ziti-edge-tunnel@sha256:2a103bdd5d242bccd7627e7b860bd37d0c49758b3f2dcda4cc7003c027910c38
ContainerName=ziti-edge-tunnel
Network=host
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
SecurityLabelDisable=true
Volume=/var/lib/ziti-edge-tunnel:/ziti-edge-tunnel
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
Exec=run --dns-ip-range 198.18.0.1/16

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
