<%- | String $host, String $mode, String $certname, Hash $mail | -%>
# Managed by OpenVox (roles::deploy_agent). docs/DEPLOY_AGENT.md.
DEPLOY_HOST=<%= $host %>
DEPLOY_MODE=<%= $mode %>
DEPLOY_APPLY=scripts/openvox-apply.sh
DEPLOY_NTFY_URL=https://ntfy.mljr.eu/deployment
# Passed through to openvox-apply.sh.
OPENVOX_CERTNAME=<%= $certname %>

# Mail fallback when ntfy fails: healthreport's account and relays.
DEPLOY_MAIL_TO=<%= $mail['to'] %>
DEPLOY_SMTP_HOST=<%= $mail['host'] %>
DEPLOY_SMTP_PORT=<%= $mail['port'] %>
DEPLOY_SMTP_USER=<%= $mail['user'] %>
DEPLOY_SMTP_PASSWORD=<%= $mail['password'] %>
DEPLOY_SMTP_FROM=<%= $mail['from'] %>
DEPLOY_SMTP2_HOST=<%= $mail['host2'] %>
DEPLOY_SMTP2_PORT=<%= $mail['port2'] %>
DEPLOY_SMTP2_USER=<%= $mail['user2'] %>
DEPLOY_SMTP2_PASSWORD=<%= $mail['password2'] %>
DEPLOY_SMTP2_FROM=<%= $mail['from2'] %>
