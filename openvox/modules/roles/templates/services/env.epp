<%- | String $service_name,
      String $domain,
      String $email,
      String $timezone,
      String $bind_addr,
      String $project_name,
      Hash $secrets,
      String $image_tag = 'latest',
| -%>
# Auto-generated .env file for <%= $service_name %>

# ============================================================================
# Common Settings
# ============================================================================
TZ=<%= $timezone %>
DOMAIN=<%= $domain %>
EMAIL=<%= $email %>

# Host interface docker publishes ports on. Defaults to loopback-only so every
# service is only reachable through Caddy; set public_bind on the service
# entry in data/common.yaml to opt a service out.
BIND_ADDR=<%= $bind_addr %>

# ============================================================================
# Service-specific Secrets
# ============================================================================
<% if $service_name == 'nocturne' { -%>
# Nocturne
INSTANCE_KEY=<%= $secrets['instance_key'] %>
BASE_DOMAIN=<%= $secrets['base_domain'] %>
POSTGRES_USERNAME=nocturne
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
POSTGRES_APP_PASSWORD=<%= $secrets['postgres_app_password'] %>
POSTGRES_MIGRATOR_PASSWORD=<%= $secrets['postgres_migrator_password'] %>
POSTGRES_WEB_PASSWORD=<%= $secrets['postgres_web_password'] %>
NOCTURNE_API_IMAGE=ghcr.io/nightscout/nocturne/nocturne-api:latest
NOCTURNE_API_PORT=8082
NOCTURNE_WEB_IMAGE=ghcr.io/nightscout/nocturne/nocturne-web:latest
<% } -%>
<% if $service_name == 'mail-archiver' { -%>
# Mail Archiver
MAILARCHIVER_DB_PASSWORD=<%= $secrets['db_password'] %>
MAILARCHIVER_ADMIN_USER=<%= $secrets['admin_user'] %>
MAILARCHIVER_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
MAILARCHIVER_OIDC_CLIENT_SECRET=<%= $secrets['oidc_client_secret'] %>
MAILARCHIVER_OIDC_ADMIN_EMAIL=<%= $secrets['oidc_admin_email'] %>
<% } -%>
<% if $service_name == 'dmarc-monitor' { -%>
# DMARC Monitor (parsedmarc)
DMARCMONITOR_IMAP_HOST=<%= $secrets['imap_host'] %>
DMARCMONITOR_IMAP_USER=<%= $secrets['imap_user'] %>
DMARCMONITOR_IMAP_PASSWORD=<%= $secrets['imap_password'] %>
DMARCMONITOR_DB_PASSWORD=<%= $secrets['db_password'] %>
<% } -%>
<% if $service_name == 'sudoku' { -%>
# Sudoku external upload API credentials
SUDOKU_API_USER=<%= $secrets['api_user'] %>
SUDOKU_API_PASSWORD=<%= $secrets['api_password'] %>
<% } -%>
<% if $service_name == 'homepage' { -%>
# GitHub
GH_TOKEN=<%= $secrets['gh_token'] %>
# Strava
STRAVA_CLIENT_ID=<%= $secrets['strava_client_id'] %>
STRAVA_CLIENT_SECRET=<%= $secrets['strava_client_secret'] %>
STRAVA_REFRESH_TOKEN=<%= $secrets['strava_refresh_token'] %>
# Umami
UMAMI_WEBSITE_ID=<%= $secrets['umami_website_id'] %>
# SMTP for contact form notifications
SMTP_HOST=<%= $secrets['smtp_host'] %>
SMTP_PORT=<%= $secrets['smtp_port'] %>
SMTP_USER=<%= $secrets['smtp_user'] %>
SMTP_PASSWORD=<%= $secrets['smtp_password'] %>
SMTP_FROM=<%= $secrets['smtp_from'] %>
CONTACT_TO=<%= $secrets['contact_to'] %>
<% } -%>
<% if $service_name == 'paperless-mail-export' { -%>
MAILARCHIVER_API_KEY=<%= $secrets['api_key'] %>
# vault_pdf_passwords holds one password per line; an .env file cannot, so the
# lines are joined with a literal backslash-n, which the exporter splits again.
PDF_PASSWORDS=<%= $secrets['pdf_passwords'].split("\n").join('\n') %>
<% } -%>
<% if $service_name == 'sure' { -%>
# Sure
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
SECRET_KEY_BASE=<%= $secrets['secret_key_base'] %>
OIDC_CLIENT_SECRET=<%= $secrets['oidc_client_secret'] %>
AR_ENCRYPTION_PRIMARY_KEY=<%= $secrets['ar_primary_key'] %>
AR_ENCRYPTION_DETERMINISTIC_KEY=<%= $secrets['ar_deterministic_key'] %>
AR_ENCRYPTION_KEY_DERIVATION_SALT=<%= $secrets['ar_key_derivation_salt'] %>
<% } -%>
<% if $service_name == 'defectdojo' { -%>
# DefectDojo
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
DD_SECRET_KEY=<%= $secrets['secret_key'] %>
DD_CREDENTIAL_AES_256_KEY=<%= $secrets['aes_key'] %>
DD_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
<% } -%>
<% if $service_name == 'glucava' { -%>
# Glucava
GLUCAVA_ADMIN_EMAIL=<%= $secrets['admin_email'] %>
GLUCAVA_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
GLUCAVA_SECRET_KEY=<%= $secrets['secret_key'] %>
GLUCAVA_DEXCOM_USERNAME=<%= $secrets['dexcom_username'] %>
GLUCAVA_DEXCOM_PASSWORD=<%= $secrets['dexcom_password'] %>
GLUCAVA_SMTP_USERNAME=<%= $secrets['smtp_username'] %>
GLUCAVA_SMTP_PASSWORD=<%= $secrets['smtp_password'] %>
<% } -%>
<% if $service_name == 'umami' { -%>
# Umami
APP_SECRET=<%= $secrets['app_secret'] %>
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
<% } -%>
<% if $service_name == 'forgejo' { -%>
# Forgejo
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
FORGEJO_RUNNER_SECRET=<%= $secrets['runner_secret'] %>
FORGEJO_OIDC_CLIENT_SECRET=<%= $secrets['oidc_client_secret'] %>
<% } -%>
<% if $service_name == 'kuma' { -%>
# Uptime Kuma
KUMA_USERNAME=<%= $secrets['username'] %>
KUMA_PASSWORD=<%= $secrets['password'] %>
<% } -%>
<% if $service_name == 'grafana' { -%>
# Grafana
GRAFANA_ADMIN_USER=<%= $secrets['admin_user'] %>
GRAFANA_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
DMARC_POSTGRES_PASSWORD=<%= $secrets['dmarc_postgres_password'] %>
GRAFANA_OIDC_CLIENT_SECRET=<%= $secrets['oidc_client_secret'] %>
<% } -%>
<% if $service_name == 'crowdsec' { -%>
# CrowdSec
CROWDSEC_FIREWALL_BOUNCER_KEY=<%= $secrets['firewall_bouncer_key'] %>
# Production Caddy's AppSec bouncer (roles::caddy)
CROWDSEC_CADDY_BOUNCER_KEY=<%= $secrets['caddy_bouncer_key'] %>
CROWDSEC_WEB_UI_PASSWORD=<%= $secrets['web_ui_password'] %>
CROWDSEC_WEB_UI_NOTIFICATION_SECRET=<%= $secrets['web_ui_notification_secret'] %>
# Machine credential for nuc's remote agent (services/crowdsec-nuc/) -
# same plaintext as nuc's own vault_crowdsec_nuc_agent_password, encrypted
# separately into each host's eyaml. post-deploy.sh registers this machine
# on the LAPI (cscli machines add nuc), nuc's agent authenticates with it.
CROWDSEC_NUC_AGENT_PASSWORD=<%= $secrets['nuc_agent_password'] %>
# Same for nas's remote agent (services/crowdsec-nas/).
CROWDSEC_NAS_AGENT_PASSWORD=<%= $secrets['nas_agent_password'] %>
<% } -%>
<% if $service_name == 'newsletter' { -%>
# Newsletter — reuses the shared SMTP secret, sends as its own address
SMTP_HOST=<%= $secrets['smtp_host'] %>
SMTP_PORT=<%= $secrets['smtp_port'] %>
SMTP_USER=<%= $secrets['smtp_user'] %>
SMTP_PASS=<%= $secrets['smtp_password'] %>
SMTP_FROM=Newsletter <noreply@mljr.eu>
<% } -%>
<% if $service_name == 'healthreport' { -%>
# Health report agent. Runs on nuc with network_mode: host, so nuc's
# services are on loopback (BIND_ADDR is 127.0.0.1).
HEALTHREPORT_VM_URL=http://127.0.0.1:19090
HEALTHREPORT_LOKI_URL=http://127.0.0.1:3100
HEALTHREPORT_KUMA_URL=http://127.0.0.1:3001
HEALTHREPORT_KUMA_API_KEY=<%= $secrets['kuma_api_key'] %>
HEALTHREPORT_GRAFANA_URL=https://monitor.<%= $domain %>
HEALTHREPORT_SCHEDULE=<%= $secrets['healthreport_schedule'] %>

# ollama on nas over Ziti (services/ziti-proxy-nuc)
HEALTHREPORT_OLLAMA_URL=http://127.0.0.1:2428
HEALTHREPORT_MODEL=<%= $secrets['healthreport_model'] %>
HEALTHREPORT_LLM_ENABLED=<%= $secrets['healthreport_llm_enabled'] %>
HEALTHREPORT_LLM_TIMEOUT=<%= $secrets['healthreport_llm_timeout'] %>

# Hosts reachable through the facts endpoint, over Ziti
# (services/ziti-proxy-nuc: facts-ssh-mljr on 2423, facts-ssh-ugreen on 2424,
# nas-ssh on 2427), nuc on its own loopback. The facts key has
# from="127.0.0.1" (roles::host_facts_endpoint), on nas from="192.168.50.80"
# (roles::unraid_host_facts_proxy: nas's router forwards from there).
HEALTHREPORT_SSH_HOSTS=mljr=127.0.0.1:2423,nuc=127.0.0.1,nas=127.0.0.1:2427,ugreen=127.0.0.1:2424
HEALTHREPORT_LOCAL_HOST=
HEALTHREPORT_SSH_KEY=/ssh/id_ed25519

HEALTHREPORT_LOOKBACK_HOURS=<%= $secrets['lookback_hours'] %>

# Scheduled outages, excluded from traffic-derived findings.
HEALTHREPORT_MAINTENANCE_WINDOWS=<%= $secrets['maintenance_windows'] %>
HEALTHREPORT_5XX_HOUR_THRESHOLD=<%= $secrets['5xx_hour_threshold'] %>

# Backup coverage drift detection (nas), from unraid_backup_paths/
# unraid_backup_excluded in openvox/data/common.yaml (services.pp joins
# each into a comma list).
HEALTHREPORT_BACKUP_KNOWN_PATHS=<%= $secrets['backup_known_paths'] %>
HEALTHREPORT_BACKUP_EXCLUDED_PATHS=<%= $secrets['backup_excluded_paths'] %>

# Home Assistant cluster names (haCluster() output, e.g. "prusa_mk4") known
# to sit unavailable on purpose, from ha_excluded_clusters in
# openvox/data/common.yaml - empty by default until triaged per-cluster.
HEALTHREPORT_HA_EXCLUDED_CLUSTERS=<%= $secrets['ha_excluded_clusters'] %>

# DefectDojo findings (nightly Trivy/Nuclei imports). The collector logs in as
# admin with the same password the service itself was initialised with.
HEALTHREPORT_DOJO_URL=http://127.0.0.1:8101
HEALTHREPORT_DOJO_PASSWORD=<%= $secrets['dojo_password'] %>

HEALTHREPORT_GITHUB_TOKEN=<%= $secrets['github_readonly_token'] %>
HEALTHREPORT_GITHUB_OWNER=<%= $secrets['github_username'] %>

HEALTHREPORT_HA_URL=http://<%= $secrets['homeassistant_ip'] %>:8123
HEALTHREPORT_HA_TOKEN=<%= $secrets['homeassistant_token'] %>

HEALTHREPORT_NTFY_URL=<%= $secrets['ntfy_url'] %>
HEALTHREPORT_NTFY_TOPIC=<%= $secrets['ntfy_topic'] %>
HEALTHREPORT_NTFY_TOKEN=<%= $secrets['ntfy_token'] %>

HEALTHREPORT_SMTP_HOST=<%= $secrets['smtp_host'] %>
HEALTHREPORT_SMTP_PORT=<%= $secrets['smtp_port'] %>
HEALTHREPORT_SMTP_USER=<%= $secrets['smtp_user'] %>
HEALTHREPORT_SMTP_PASSWORD=<%= $secrets['smtp_password'] %>
HEALTHREPORT_SMTP_FROM=<%= $secrets['smtp_from'] %>
# Optional backup relay (independent of mail.mljr.eu); leave the
# smtp2_* secrets unset to disable.
HEALTHREPORT_SMTP2_HOST=<%= pick($secrets['smtp2_host'], '') %>
HEALTHREPORT_SMTP2_PORT=<%= pick($secrets['smtp2_port'], '587') %>
HEALTHREPORT_SMTP2_USER=<%= pick($secrets['smtp2_user'], '') %>
HEALTHREPORT_SMTP2_PASSWORD=<%= pick($secrets['smtp2_password'], '') %>
HEALTHREPORT_SMTP2_FROM=<%= pick($secrets['smtp2_from'], '') %>
HEALTHREPORT_EMAIL_TO=<%= $secrets['email_to'] %>
# HetrixTools heartbeat, pinged after a report reached a channel: alerts
# from outside the fleet when every channel here is down. Empty: off.
HEALTHREPORT_HEARTBEAT_URL=<%= $secrets['heartbeat_url'] %>
# Hosts running deploy-agent: requested (deploy/<host> on GitHub) vs
# reported (agent metrics in VictoriaMetrics). Empty: off.
HEALTHREPORT_DEPLOY_HOSTS=<%= pick($secrets['deploy_hosts'], '') %>

# services/dmarc-monitor's Postgres, published on loopback (BIND_ADDR).
# Grafana reaches it over the compose network instead.
<% if $secrets['dmarc_db_password'] != '' { -%>
HEALTHREPORT_DMARC_DB_URL=postgres://parsedmarc:<%= $secrets['dmarc_db_password'] %>@127.0.0.1:5432/parsedmarc?sslmode=disable
<% } else { -%>
HEALTHREPORT_DMARC_DB_URL=
<% } -%>
HEALTHREPORT_DMARC_DOMAINS=<%= $secrets['dmarc_domains'] %>
<% } -%>
<% if $service_name == 'crowdsec-nuc' { -%>
# Agent-only crowdsec: registers to mljr's LAPI (see services/crowdsec/
# docker-compose.yml's tailnet-reachable host port 8088, mapped to the
# LAPI's container-internal 8080) and pushes detections there rather
# than running its own local API or bouncer - bans still enforce at
# mljr, the actual internet edge. Over Ziti through the ziti-proxy service
# in services/crowdsec-nuc (identity crowdsec-nuc, ziti/tofu/m2m.tf).
CROWDSEC_LOCAL_API_URL=http://ziti-proxy:8088
CROWDSEC_AGENT_USERNAME=nuc
CROWDSEC_AGENT_PASSWORD=<%= $secrets['crowdsec_agent_password'] %>
<% } -%>
<% if $service_name == 'crowdsec-nas' { -%>
# Agent-only crowdsec, same shape as crowdsec-nuc above: mljr's LAPI over
# Ziti through the ziti-proxy service in services/crowdsec-nas (identity
# crowdsec-nas, ziti/tofu/m2m.tf). The running container talks to mljr on
# its own; nuc only deploys it (roles::services_nas).
CROWDSEC_LOCAL_API_URL=http://ziti-proxy:8088
CROWDSEC_AGENT_USERNAME=nas
CROWDSEC_AGENT_PASSWORD=<%= $secrets['crowdsec_agent_password'] %>
<% } -%>
<% if $service_name == 'immich-kiosk' { -%>
KIOSK_IMMICH_API_KEY='<%= $secrets['api_key'] %>'
<% } -%>
<% if $service_name == 'dawarich' { -%>
DAWARICH_DB_PASSWORD='<%= $secrets['db_password'] %>'
DAWARICH_SECRET_KEY_BASE='<%= $secrets['secret_key_base'] %>'
DAWARICH_VALKEY_PASSWORD='<%= $secrets['valkey_password'] %>'
<% } -%>
<% if $service_name == 'immich' { -%>
IMMICH_DB_PASSWORD='<%= $secrets['db_password'] %>'
<% } -%>
<% if $service_name == 'paperless' { -%>
PAPERLESS_DB_PASSWORD='<%= $secrets['db_password'] %>'
PAPERLESS_SECRET_KEY='<%= $secrets['secret_key'] %>'
PAPERLESS_ADMIN_PASSWORD='<%= $secrets['admin_password'] %>'
PAPERLESS_OIDC_CLIENT_SECRET='<%= $secrets['oidc_client_secret'] %>'
<% } -%>
<% if $service_name == 'ollama' { -%>
# Consumed by hooks/post-deploy.sh to pull the triage model.
HEALTHREPORT_MODEL=<%= $secrets['healthreport_model'] %>
<% } -%>
<% if $service_name == 'syncthing-ugreen' { -%>
# The NAS's Syncthing API key, hand-added to common.eyaml as
# vault_syncthing_nas_api_key (not vault-sourced - it already exists on
# the NAS, set up manually, see that file's own comment). NAS_SYNCTHING_URL
# is nas's Syncthing REST API over Ziti (services/ziti-proxy-ugreen,
# m2m-ugreen). The sync traffic itself stays on the LAN (22000).
NAS_SYNCTHING_URL=http://127.0.0.1:8385
NAS_SYNCTHING_API_KEY=<%= $secrets['nas_syncthing_api_key'] %>
<% } -%>
<% if $service_name == 'backup-dashboard' { -%>
# Backup dashboard collector. Runs on nuc with network_mode: host, reuses
# healthreport's own SSH key (mounted read-only).
BACKUP_DASHBOARD_VICTORIA_URL=http://127.0.0.1:19090
# Same hosts and paths as HEALTHREPORT_SSH_HOSTS.
BACKUP_DASHBOARD_SSH_HOSTS=mljr=127.0.0.1:2423,nuc=127.0.0.1,nas=127.0.0.1:2427,ugreen=127.0.0.1:2424
BACKUP_DASHBOARD_SSH_KEY_PATH=/ssh/id_ed25519
BACKUP_DASHBOARD_REFRESH_INTERVAL=<%= $secrets['refresh_interval'] %>
<% } -%>
<% if $service_name == 'ntfy' { -%>
# Consumed by hooks/post-deploy.sh to grant `everyone <topic> read-write`
# per whitelisted topic (ntfy_topic_whitelist in openvox/data/common.yaml)
# - server.yml sets auth-default-access: deny-all, so anything not in this
# list is otherwise unreachable.
NTFY_TOPIC_WHITELIST=<%= $secrets['topic_whitelist'] %>
<% } -%>
<% if $service_name == 'ziti-controller' { -%>
# Default admin, created once by hooks/post-deploy.sh (ziti agent cluster init)
ZITI_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
# OpenTofu state encryption (scripts/ziti-tofu.sh), copy in Bitwarden
ZITI_TOFU_KEY=<%= $secrets['tofu_key'] %>
# Password of zac-readonly, the read-only web console login (set by
# scripts/ziti-tofu.sh from ziti/tofu/updb.txt)
ZITI_ZAC_PASSWORD=<%= $secrets['zac_password'] %>
<% } -%>
<% if $service_name == 'ziti-console' { -%>
# The proxy logs in as zac-readonly with it (tools/cmd/ziti-console-proxy)
ZITI_ZAC_PASSWORD=<%= $secrets['zac_password'] %>
# Caddy sends it as X-Upstream-Secret; the proxy refuses requests without it
ZITI_CONSOLE_UPSTREAM_SECRET=<%= $secrets['upstream_secret'] %>
<% } -%>

# ============================================================================
# Docker Configuration
# ============================================================================
IMAGE_TAG=<%= $image_tag %>
COMPOSE_PROJECT_NAME=<%= $project_name %>
