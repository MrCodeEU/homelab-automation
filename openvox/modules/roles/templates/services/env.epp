<%- | String $service_name,
      String $domain,
      String $email,
      String $timezone,
      String $bind_addr,
      String $project_name,
      Hash $secrets,
| -%>
# Auto-generated .env file for <%= $service_name %>

# ============================================================================
# Common Settings
# ============================================================================
TZ=<%= $timezone %>
DOMAIN=<%= $domain %>
EMAIL=<%= $email %>

# Host interface docker publishes ports on. Defaults to loopback-only so every
# service is only reachable through Caddy; set public_bind on the service
# entry in data/common.yaml to opt a service out.
BIND_ADDR=<%= $bind_addr %>

# ============================================================================
# Service-specific Secrets
# ============================================================================
<% if $service_name == 'nocturne' { -%>
# Nocturne
INSTANCE_KEY=<%= $secrets['instance_key'] %>
BASE_DOMAIN=<%= $secrets['base_domain'] %>
POSTGRES_USERNAME=nocturne
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
POSTGRES_APP_PASSWORD=<%= $secrets['postgres_app_password'] %>
POSTGRES_MIGRATOR_PASSWORD=<%= $secrets['postgres_migrator_password'] %>
POSTGRES_WEB_PASSWORD=<%= $secrets['postgres_web_password'] %>
NOCTURNE_API_IMAGE=ghcr.io/nightscout/nocturne/nocturne-api:latest
NOCTURNE_API_PORT=8082
NOCTURNE_WEB_IMAGE=ghcr.io/nightscout/nocturne/nocturne-web:latest
<% } -%>
<% if $service_name == 'mail-archiver' { -%>
# Mail Archiver
MAILARCHIVER_DB_PASSWORD=<%= $secrets['db_password'] %>
MAILARCHIVER_ADMIN_USER=<%= $secrets['admin_user'] %>
MAILARCHIVER_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
<% } -%>
<% if $service_name == 'sudoku' { -%>
# Sudoku external upload API credentials
SUDOKU_API_USER=<%= $secrets['api_user'] %>
SUDOKU_API_PASSWORD=<%= $secrets['api_password'] %>
<% } -%>
<% if $service_name == 'homepage' { -%>
# GitHub
GH_TOKEN=<%= $secrets['gh_token'] %>
# Strava
STRAVA_CLIENT_ID=<%= $secrets['strava_client_id'] %>
STRAVA_CLIENT_SECRET=<%= $secrets['strava_client_secret'] %>
STRAVA_REFRESH_TOKEN=<%= $secrets['strava_refresh_token'] %>
# Umami
UMAMI_WEBSITE_ID=<%= $secrets['umami_website_id'] %>
# Tailscale mesh panel (read-only devices-scope API key, caps out at 90 days)
TAILSCALE_API_KEY=<%= $secrets['tailscale_api_key'] %>
# SMTP for contact form notifications
SMTP_HOST=<%= $secrets['smtp_host'] %>
SMTP_PORT=<%= $secrets['smtp_port'] %>
SMTP_USER=<%= $secrets['smtp_user'] %>
SMTP_PASSWORD=<%= $secrets['smtp_password'] %>
SMTP_FROM=<%= $secrets['smtp_from'] %>
CONTACT_TO=<%= $secrets['contact_to'] %>
<% } -%>
<% if $service_name == 'umami' { -%>
# Umami
APP_SECRET=<%= $secrets['app_secret'] %>
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
<% } -%>
<% if $service_name == 'forgejo' { -%>
# Forgejo
POSTGRES_PASSWORD=<%= $secrets['postgres_password'] %>
FORGEJO_RUNNER_SECRET=<%= $secrets['runner_secret'] %>
<% } -%>
<% if $service_name == 'kuma' { -%>
# Uptime Kuma
KUMA_USERNAME=<%= $secrets['username'] %>
KUMA_PASSWORD=<%= $secrets['password'] %>
<% } -%>
<% if $service_name == 'grafana' { -%>
# Grafana
GRAFANA_ADMIN_USER=<%= $secrets['admin_user'] %>
GRAFANA_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
<% } -%>
<% if $service_name == 'crowdsec' { -%>
# CrowdSec
CROWDSEC_FIREWALL_BOUNCER_KEY=<%= $secrets['firewall_bouncer_key'] %>
CROWDSEC_WEB_UI_PASSWORD=<%= $secrets['web_ui_password'] %>
CROWDSEC_WEB_UI_NOTIFICATION_SECRET=<%= $secrets['web_ui_notification_secret'] %>
<% } -%>
<% if $service_name == 'newsletter' { -%>
# Newsletter — reuses the shared SMTP secret, sends as its own address
SMTP_HOST=<%= $secrets['smtp_host'] %>
SMTP_PORT=<%= $secrets['smtp_port'] %>
SMTP_USER=<%= $secrets['smtp_user'] %>
SMTP_PASS=<%= $secrets['smtp_password'] %>
SMTP_FROM=Newsletter <noreply@mljr.eu>
<% } -%>
<% if $service_name == 'speedtest' { -%>
# Netronome
NETRONOME_ADMIN_PASSWORD=<%= $secrets['admin_password'] %>
NETRONOME_SESSION_SECRET=<%= $secrets['session_secret'] %>
# SMTP for speedtest notifications
SMTP_HOST=<%= $secrets['smtp_host'] %>
SMTP_PORT=<%= $secrets['smtp_port'] %>
SMTP_USER=<%= $secrets['smtp_user'] %>
SMTP_PASSWORD=<%= $secrets['smtp_password'] %>
SMTP_FROM=<%= $secrets['smtp_from'] %>
<% } -%>
<% if $service_name == 'healthreport' { -%>
# Health report agent. Runs on nuc with network_mode: host, so the
# observability stack is reachable on this host's own interfaces.
HEALTHREPORT_VM_URL=http://<%= $secrets['nuc_ip'] %>:19090
HEALTHREPORT_LOKI_URL=http://<%= $secrets['nuc_ip'] %>:3100
HEALTHREPORT_KUMA_URL=http://<%= $secrets['nuc_ip'] %>:3001
HEALTHREPORT_KUMA_API_KEY=<%= $secrets['kuma_api_key'] %>
HEALTHREPORT_GRAFANA_URL=https://monitor.<%= $domain %>
HEALTHREPORT_SCHEDULE=<%= $secrets['healthreport_schedule'] %>

HEALTHREPORT_OLLAMA_URL=http://<%= $secrets['nas_ip'] %>:11434
HEALTHREPORT_MODEL=<%= $secrets['healthreport_model'] %>
HEALTHREPORT_LLM_ENABLED=<%= $secrets['healthreport_llm_enabled'] %>
HEALTHREPORT_LLM_TIMEOUT=<%= $secrets['healthreport_llm_timeout'] %>

# Hosts reachable through the facts endpoint.
HEALTHREPORT_SSH_HOSTS=mljr=<%= $secrets['mljr_ip'] %>,nuc=<%= $secrets['nuc_ip'] %>,nas=<%= $secrets['nas_ip'] %>,ugreen=<%= $secrets['ugreen_ip'] %>
HEALTHREPORT_LOCAL_HOST=
HEALTHREPORT_SSH_KEY=/ssh/id_ed25519

HEALTHREPORT_LOOKBACK_HOURS=<%= $secrets['lookback_hours'] %>

# Scheduled outages, excluded from traffic-derived findings.
HEALTHREPORT_MAINTENANCE_WINDOWS=<%= $secrets['maintenance_windows'] %>
HEALTHREPORT_5XX_HOUR_THRESHOLD=<%= $secrets['5xx_hour_threshold'] %>

# Backup coverage drift detection (nas), from unraid_backup_paths/
# unraid_backup_excluded in openvox/data/common.yaml (services.pp joins
# each into a comma list).
HEALTHREPORT_BACKUP_KNOWN_PATHS=<%= $secrets['backup_known_paths'] %>
HEALTHREPORT_BACKUP_EXCLUDED_PATHS=<%= $secrets['backup_excluded_paths'] %>

HEALTHREPORT_GITHUB_TOKEN=<%= $secrets['github_readonly_token'] %>
HEALTHREPORT_GITHUB_OWNER=<%= $secrets['github_username'] %>

HEALTHREPORT_HA_URL=http://<%= $secrets['homeassistant_ip'] %>:8123
HEALTHREPORT_HA_TOKEN=<%= $secrets['homeassistant_token'] %>

HEALTHREPORT_NTFY_URL=<%= $secrets['ntfy_url'] %>
HEALTHREPORT_NTFY_TOPIC=<%= $secrets['ntfy_topic'] %>
HEALTHREPORT_NTFY_TOKEN=<%= $secrets['ntfy_token'] %>

HEALTHREPORT_SMTP_HOST=<%= $secrets['smtp_host'] %>
HEALTHREPORT_SMTP_PORT=<%= $secrets['smtp_port'] %>
HEALTHREPORT_SMTP_USER=<%= $secrets['smtp_user'] %>
HEALTHREPORT_SMTP_PASSWORD=<%= $secrets['smtp_password'] %>
HEALTHREPORT_SMTP_FROM=<%= $secrets['smtp_from'] %>
HEALTHREPORT_EMAIL_TO=<%= $secrets['email_to'] %>
<% } -%>
<% if $service_name == 'ollama' { -%>
# Consumed by hooks/post-deploy.sh to pull the triage model.
HEALTHREPORT_MODEL=<%= $secrets['healthreport_model'] %>
<% } -%>
<% if $service_name == 'syncthing-ugreen' { -%>
# The NAS's Syncthing API key, hand-added to common.eyaml as
# vault_syncthing_nas_api_key (not vault-sourced - it already exists on
# the NAS, set up manually, see that file's own comment). NAS_SYNCTHING_URL
# is static, not a secret - nas's tailscale_ip hardcoded here rather than
# looked up, same precedent as healthreport/backup-dashboard's own
# nuc_ip/mljr_ip/nas_ip secrets-Hash entries.
NAS_SYNCTHING_URL=http://<%= $secrets['nas_ip'] %>:8384
NAS_SYNCTHING_API_KEY=<%= $secrets['nas_syncthing_api_key'] %>
<% } -%>
<% if $service_name == 'backup-dashboard' { -%>
# Backup dashboard collector. Runs on nuc with network_mode: host, reuses
# healthreport's own SSH key (mounted read-only).
BACKUP_DASHBOARD_VICTORIA_URL=http://<%= $secrets['nuc_ip'] %>:19090
BACKUP_DASHBOARD_SSH_HOSTS=mljr=<%= $secrets['mljr_ip'] %>,nuc=<%= $secrets['nuc_ip'] %>,nas=<%= $secrets['nas_ip'] %>
BACKUP_DASHBOARD_SSH_KEY_PATH=/ssh/id_ed25519
BACKUP_DASHBOARD_REFRESH_INTERVAL=<%= $secrets['refresh_interval'] %>
<% } -%>

# ============================================================================
# Docker Configuration
# ============================================================================
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=<%= $project_name %>
