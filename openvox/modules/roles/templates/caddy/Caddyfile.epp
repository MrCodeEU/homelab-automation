<%- | String $email,
      String $log_path,
      String $base_path,
      String $domain,
      String $roll_size,
      Integer $roll_keep,
      String $roll_keep_for,
      Boolean $roll_uncompressed,
      Boolean $appsec_enabled = false,
| -%>
# Caddyfile - Auto-generated by OpenVox
# NOTE: This file is validated with 'caddy validate --adapter caddyfile' before deployment
# Service configs live in /etc/caddy/conf.d/ — one snippet per service
# ============================================================================

{
    email <%= $email %>

    servers {
        timeouts {
            # Allow slow mobile clients to finish large uploads without Caddy returning 408.
            read_body 0
        }
    }

<% if $appsec_enabled { -%>
    # CrowdSec AppSec (WAF), docs/APPSEC_POC_PLAN.md. Only the AppSec handler is
    # used per vhost (the firewall bouncer already enforces IP decisions), so a
    # down or slow AppSec must never cost a request: fail open, 2 s cap, and
    # only the first 1 MiB of a body is sent for inspection.
    crowdsec {
        api_url http://127.0.0.1:8088
        api_key {env.CROWDSEC_BOUNCER_KEY}
        ticker_interval 15s
        appsec_url http://127.0.0.1:7422
        appsec_fail_open
        appsec_max_body_bytes 1048576
        appsec_timeout 2s
    }

<% } -%>
    # Global access log for GoAccess real-time analytics
    log access {
        output file <%= $log_path %>/caddy/access.log {
            roll_size <%= $roll_size %>
            roll_keep <%= $roll_keep %>
            roll_keep_for <%= $roll_keep_for %>
<% if $roll_uncompressed { -%>
            roll_uncompressed
<% } -%>
        }
    }
}

# Deployment Status Page
deploy.<%= $domain %> {
    root * <%= $base_path %>/caddy/site
    file_server
    log {
        output file <%= $log_path %>/caddy/deploy.log {
            roll_size <%= $roll_size %>
            roll_keep <%= $roll_keep %>
            roll_keep_for <%= $roll_keep_for %>
<% if $roll_uncompressed { -%>
            roll_uncompressed
<% } -%>
        }
    }
}

# Per-service snippets (auth macros + individual service configs)
import /etc/caddy/conf.d/*.caddy
