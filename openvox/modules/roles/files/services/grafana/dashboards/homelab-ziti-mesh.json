{
  "uid": "homelab-ziti-mesh",
  "title": "Ziti mesh",
  "tags": [
    "homelab",
    "network",
    "ziti"
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "State of the Ziti overlay from services/ziti-mesh-exporter (read-only identity mesh-exporter on mljr): routers, links, client identities, services, open circuits.",
  "templating": {
    "list": [
      {
        "name": "view",
        "label": "View",
        "type": "custom",
        "query": "Everything : router|identity|service, Routers and clients : router|identity, Routers : router",
        "current": {
          "text": "Routers and clients",
          "value": "router|identity"
        },
        "options": [
          {
            "text": "Everything",
            "value": "router|identity|service",
            "selected": false
          },
          {
            "text": "Routers and clients",
            "value": "router|identity",
            "selected": true
          },
          {
            "text": "Routers",
            "value": "router",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "nodeGraph",
      "title": "Mesh",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 20
      },
      "description": "Nodes: routers, client identities (sidecars, laptop, phone), services. Green online/active, red offline or no terminator, gray idle. Node value: open circuits. Edges: router links (latency in ms), client to ingress router and egress router to service (open circuits), router to hosted service (0 = idle).",
      "targets": [
        {
          "refId": "nodes",
          "instant": true,
          "format": "table",
          "expr": "ziti_mesh_node{kind=~\"$view\"}"
        },
        {
          "refId": "edges",
          "instant": true,
          "format": "table",
          "expr": "ziti_mesh_edge and on(source) label_replace(ziti_mesh_node{kind=~\"$view\"}, \"source\", \"$1\", \"id\", \"(.*)\") and on(target) label_replace(ziti_mesh_node{kind=~\"$view\"}, \"target\", \"$1\", \"id\", \"(.*)\")"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "kind": true,
              "state": true
            },
            "renameByName": {
              "Value #nodes": "mainstat",
              "Value #edges": "mainstat"
            }
          }
        }
      ],
      "options": {
        "layoutAlgorithm": "force",
        "nodes": {},
        "edges": {}
      }
    },
    {
      "type": "stat",
      "title": "Routers online",
      "description": "Edge routers connected to the controller.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ziti_mesh_router_online)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Links up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ziti_mesh_link_up)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Identities online",
      "description": "Client identities with an edge router connection (routers excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ziti_mesh_identity_online)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Open circuits",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ziti_mesh_circuits)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Max link latency",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(ziti_mesh_link_latency_seconds)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Exporter read",
      "description": "1 when the exporter's last read of the controller succeeded; 0 shows the last good state.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 20,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(ziti_mesh_read_success)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Offline identities",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "description": "Client identities without an edge router connection right now. A sidecar here has lost its overlay connection.",
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "ziti_mesh_identity_online == 0"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "host": true,
              "Value": true
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Link latency",
      "description": "Router link latency, the higher of the two ends' measurements.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (source, target) (ziti_mesh_link_latency_seconds)",
          "legendFormat": "{{source}} - {{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Open circuits by service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (ziti_mesh_circuits)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Faults and retransmissions",
      "description": "From the controller's own metrics (job ziti-controller), per 5 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ziti_faults_link[5m]))",
          "legendFormat": "link faults"
        },
        {
          "refId": "B",
          "expr": "sum(increase(ziti_faults_circuit[5m]))",
          "legendFormat": "circuit faults"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ziti_xgress_retransmissions[5m]))",
          "legendFormat": "retransmissions/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "logs",
      "title": "Controller events (router, authentication, entity changes)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"ziti-events\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
