{
  "uid": "homelab-storage",
  "title": "Homelab Storage & Host Health",
  "tags": ["homelab", "storage", "smart", "systemd", "btrfs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(node_uname_info, host)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Systemd Failed Units",
      "description": "Unraid/wd-mycloud never report here (no systemd) - that's expected, not a gap.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(node_systemd_unit_state{host=~\"$host\",state=\"failed\"})"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SMART Status (0 = FAILING)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["min"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "min(smartctl_device_smart_status{host=~\"$host\"})"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "btrfs Device Errors (all-time counters)",
      "description": "Any non-zero value here is worth investigating - these counters never self-reset.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(node_btrfs_device_errors_total{host=~\"$host\"})"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Disks Reporting SMART",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "sum(smartctl_devices{host=~\"$host\"})"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SMART Temperature by Device",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 60}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "smartctl_device_temperature{host=~\"$host\",temperature_type=\"current\"}", "legendFormat": "{{host}} / {{device}}"}]
    },
    {
      "id": 6,
      "type": "table",
      "title": "SMART Health Detail",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}}, "overrides": []},
      "options": {"showHeader": true},
      "transformations": [
        {"id": "merge", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true}, "renameByName": {"host": "Host", "device": "Device", "Value #A": "SMART OK", "Value #B": "Power-On Hours", "Value #C": "Media Errors"}}}
      ],
      "targets": [
        {"refId": "A", "expr": "smartctl_device_smart_status{host=~\"$host\"}", "format": "table", "instant": true},
        {"refId": "B", "expr": "smartctl_device_power_on_seconds{host=~\"$host\"} / 3600", "format": "table", "instant": true},
        {"refId": "C", "expr": "smartctl_device_media_errors{host=~\"$host\"}", "format": "table", "instant": true}
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Systemd Failed Units Detail",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []},
      "options": {"showHeader": true},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "state": true, "Value": true}, "renameByName": {"host": "Host", "name": "Unit"}}}],
      "targets": [{"refId": "A", "expr": "node_systemd_unit_state{host=~\"$host\",state=\"failed\"} == 1", "format": "table", "instant": true}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "btrfs Pool Usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "node_btrfs_used_bytes{host=~\"$host\"}", "legendFormat": "{{host}} used"},
        {"refId": "B", "expr": "node_btrfs_size_bytes{host=~\"$host\"}", "legendFormat": "{{host}} total"}
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Disk Usage - All Mounts (beyond root)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 19},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "custom": {"align": "auto", "cellOptions": {"type": "color-background"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"showHeader": true, "sortBy": [{"displayName": "Value", "desc": true}]},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "device": true, "fstype": true}, "renameByName": {"host": "Host", "mountpoint": "Mount", "Value": "Used %"}}}],
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_filesystem_avail_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\"} / node_filesystem_size_bytes{host=~\"$host\",fstype!~\"tmpfs|overlay|squashfs|devtmpfs\"}))", "format": "table", "instant": true}]
    }
  ]
}
