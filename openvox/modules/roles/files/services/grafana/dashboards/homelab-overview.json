{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "tags": ["homelab", "linux", "docker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(node_uname_info, host)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {"selected": true, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU Busy",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "100 - (avg by(host) (rate(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "{{host}}"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory Used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}))", "legendFormat": "{{host}}"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Root Disk Used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_filesystem_avail_bytes{host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"}))", "legendFormat": "{{host}}"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "cAdvisor Container Series",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "count by(host) (container_last_seen{host=~\"$host\",id!=\"/\"})", "legendFormat": "{{host}}"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU Busy by Host",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "100 - (avg by(host) (rate(node_cpu_seconds_total{host=~\"$host\",mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "{{host}}"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory Used by Host",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "100 * (1 - (node_memory_MemAvailable_bytes{host=~\"$host\"} / node_memory_MemTotal_bytes{host=~\"$host\"}))", "legendFormat": "{{host}}"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network Throughput",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum by(host) (rate(node_network_receive_bytes_total{host=~\"$host\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval]))", "legendFormat": "{{host}} rx"},
        {"refId": "B", "expr": "sum by(host) (rate(node_network_transmit_bytes_total{host=~\"$host\",device!~\"lo|docker.*|veth.*|br-.*\"}[$__rate_interval]))", "legendFormat": "{{host}} tx"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container CPU Usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "topk(10, sum by(host, id) (rate(container_cpu_usage_seconds_total{host=~\"$host\",id!=\"/\"}[$__rate_interval])))", "legendFormat": "{{host}} / {{id}}"}]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Recent Homelab Logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 21},
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": false, "dedupStrategy": "none", "sortOrder": "Descending"},
      "targets": [{"refId": "A", "expr": "{host=~\"$host\", job=~\"system|auth|caddy|docker\"}"}]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Fleet Status (scrape targets up/down)",
      "description": "Every Alloy/exporter scrape target across the fleet - the first thing to check when something seems off. 0 = target unreachable.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "color-background"}}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"showHeader": true, "sortBy": [{"displayName": "Value", "desc": false}]},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}, "renameByName": {"host": "Host", "job": "Job", "instance": "Instance", "Value": "Status"}}}],
      "targets": [{"refId": "A", "expr": "up", "format": "table", "instant": true}]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Last Successful OpenVox Apply",
      "description": "Timestamp of the latest successful production apply per host.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 39},
      "fieldConfig": {"defaults": {"unit": "dateTimeAsSystem", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "last_over_time(homelab_openvox_last_success_timestamp_seconds{mode=\"apply\"}[30d]) * 1000", "legendFormat": "{{host}}"}]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Latest OpenVox Apply Result",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 39},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "mappings": [{"type": "value", "options": {"0": {"text": "FAILED", "color": "red"}, "1": {"text": "OK", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "last_over_time(homelab_openvox_run_success{mode=\"apply\"}[30d])", "legendFormat": "{{host}}"}]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Latest OpenVox Apply Duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 39},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 120}, {"color": "red", "value": 300}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "last_over_time(homelab_openvox_run_duration_seconds{mode=\"apply\"}[30d])", "legendFormat": "{{host}}"}]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Latest OpenVox Apply Changes",
      "description": "Changed Puppet resources in the latest production apply.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 39},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 30}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto"},
      "targets": [{"refId": "A", "expr": "last_over_time(homelab_openvox_resource_changes{mode=\"apply\"}[30d])", "legendFormat": "{{host}}"}]
    }
  ]
}
