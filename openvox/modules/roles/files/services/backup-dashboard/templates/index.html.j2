<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Backup Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, sans-serif; margin: 0; padding: 1.5rem; max-width: 1100px; margin-inline: auto; }
  h1 { font-size: 1.4rem; margin-bottom: 0.25rem; }
  .meta { color: #888; font-size: 0.85rem; margin-bottom: 1.5rem; }
  .summary { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .card { border: 1px solid #8883; border-radius: 8px; padding: 0.75rem 1rem; min-width: 160px; }
  .card h3 { margin: 0 0 0.4rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; color: #888; }
  .card .value { font-size: 1.3rem; font-weight: 600; }
  .gauge-bar { height: 6px; border-radius: 3px; background: #8882; margin-top: 0.4rem; overflow: hidden; }
  .gauge-fill { height: 100%; }
  .fill-ok { background: #2ea043; }
  .fill-warn { background: #d4a72c; }
  .fill-crit { background: #d73a49; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #8882; font-size: 0.9rem; }
  th { color: #888; font-weight: 500; font-size: 0.8rem; text-transform: uppercase; }
  .type-badge { font-size: 0.75rem; padding: 0.1rem 0.4rem; border-radius: 4px; background: #8882; }
  .dest { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.78rem; margin-right: 0.25rem; }
  .dest-ok { background: #2ea04333; color: #2ea043; }
  .dest-degraded { background: #d4a72c33; color: #d4a72c; }
  .dest-failed { background: #d73a4933; color: #d73a49; }
  .dest-unknown { background: #8883; color: #888; }
  .source { font-family: ui-monospace, monospace; font-size: 0.82rem; color: #aaa; }
  .errors { margin-top: 1.5rem; padding: 0.75rem 1rem; border: 1px solid #d73a4955; border-radius: 8px; background: #d73a4911; }
  .errors h3 { margin-top: 0; font-size: 0.9rem; color: #d73a49; }
</style>
</head>
<body>
  <h1>Backup Dashboard</h1>
  <div class="meta">
    Generated {{ generated_at }}
    {% if catalog_generated_at %}&middot; catalog rendered {{ catalog_generated_at }}{% endif %}
    &middot; Phase 1 (MVP): destination badges reflect each host's last full backup run, not this individual entry - see the plan for the per-entry status planned in Phase 2.
  </div>

  <div class="summary">
    {% for host, status in hosts.items() %}
    <div class="card">
      <h3>{{ host }}</h3>
      <div class="value dest-{{ status.state }}" style="display:inline-block; padding:0.1rem 0;">
        {{ status.state }}
      </div>
      {% if status.age_seconds is not none %}
      <div style="font-size:0.78rem; color:#888;">last run {{ (status.age_seconds / 3600) | round(1) }}h ago</div>
      {% elif status.reason %}
      <div style="font-size:0.78rem; color:#888;">{{ status.reason }}</div>
      {% endif %}
    </div>
    {% endfor %}
    {% for name, usage in destinations.items() %}
    <div class="card">
      <h3>{{ name }}</h3>
      <div class="value">{{ usage.used_percent }}%</div>
      <div class="gauge-bar"><div class="gauge-fill {{ 'fill-crit' if usage.used_percent > 90 else ('fill-warn' if usage.used_percent > 80 else 'fill-ok') }}" style="width: {{ usage.used_percent }}%;"></div></div>
      <div style="font-size:0.78rem; color:#888;">{{ usage.free_gib }} GiB free</div>
    </div>
    {% endfor %}
  </div>

  <table>
    <thead>
      <tr>
        <th>Entry</th>
        <th>Type</th>
        <th>Host</th>
        <th>Source</th>
        <th>Destinations</th>
      </tr>
    </thead>
    <tbody>
      {% for entry in entries %}
      <tr>
        <td>{{ entry.name }}</td>
        <td><span class="type-badge">{{ '📁 folder' if entry.type == 'folder' else '🐳 service' }}</span></td>
        <td>{{ entry.host }}</td>
        <td class="source">{{ entry.source if entry.source is string else entry.source | join(', ') }}</td>
        <td>
          {% for dest in entry.destinations %}
          <span class="dest dest-{{ entry.badge }}">{{ dest }}</span>
          {% endfor %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if errors %}
  <div class="errors">
    <h3>Unreachable hosts</h3>
    <ul>
      {% for host, reason in errors.items() %}
      <li>{{ host }}: {{ reason }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</body>
</html>
