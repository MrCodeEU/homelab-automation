
crowdsec.mljr.eu, security.mljr.eu {
    log {
        output file /var/log/caddy/crowdsec.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers
    import authelia_auth

    reverse_proxy localhost:8089
}

