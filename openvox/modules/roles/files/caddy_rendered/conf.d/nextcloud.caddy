
cloud.mljr.eu {
    log {
        output file /var/log/caddy/nextcloud.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers

    reverse_proxy nas.tail33930.ts.net:11000 {
        # Buffer upload bodies so slow mobile clients don't trickle into
        # Apache's mod_reqtimeout (body=20,MinRate=500) -> 408 storms.
        # Sized above the 10MB Nextcloud client chunk size.
        request_buffers 16m
        transport http {
            versions 1.1
        }
    }

}

