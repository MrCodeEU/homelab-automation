
monitor.mljr.eu, grafana.mljr.eu {
    log {
        output file /var/log/caddy/grafana.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers
    import authelia_auth

    reverse_proxy nuc.tail33930.ts.net:3000
}

