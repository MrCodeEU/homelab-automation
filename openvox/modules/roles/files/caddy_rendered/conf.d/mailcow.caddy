
mail.mljr.eu {
    log {
        output file /var/log/caddy/mailcow.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers

    reverse_proxy https://localhost:8443 {
        transport http {
            tls_insecure_skip_verify
        }
        header_up Host {http.request.host}
    }
}

