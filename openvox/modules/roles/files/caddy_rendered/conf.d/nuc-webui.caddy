
nuc.mljr.eu {
    log {
        output file /var/log/caddy/nuc-webui.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers

    reverse_proxy https://nuc.tail33930.ts.net:9090 {
        transport http {
            tls_insecure_skip_verify
        }
        header_up Host {http.request.host}
    }
}

