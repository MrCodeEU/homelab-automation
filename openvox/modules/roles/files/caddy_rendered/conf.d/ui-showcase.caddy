
ui.mljr.eu {
    log {
        output file /var/log/caddy/ui-showcase.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers

    reverse_proxy localhost:8083
}

ui.dev.mljr.eu {
    log {
        output file /var/log/caddy/ui-showcase-staging.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers
    reverse_proxy nuc.tail33930.ts.net:18083
}
