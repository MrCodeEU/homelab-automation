
immich.mljr.eu {
    log {
        output file /var/log/caddy/immich.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers

    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "*"
        header Access-Control-Allow-Methods "GET, PUT, POST, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "X-Api-Key, User-Agent, Content-Type, Authorization"
        header Access-Control-Max-Age "1728000"
        respond 204
    }
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Headers "X-Api-Key, User-Agent, Content-Type, Authorization"

    reverse_proxy nas.tail33930.ts.net:8080
}

