
mljr.eu {
    log {
        output file /var/log/caddy/homepage.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers

    handle_path /umami* {
        reverse_proxy nuc.tail33930.ts.net:3606
    }

    # robots.txt disallows a handful of decoy paths that no real route on
    # mljr.eu ever uses. Bots that respect it never touch them. Bots that
    # don't get routed straight into HellPot instead of the real backend.
    respond /robots.txt 200 {
        body "User-agent: *
    Disallow: /wp-admin/
    Disallow: /wp-login.php
    Disallow: /xmlrpc.php
    Disallow: /.env
    Disallow: /.git/
    Disallow: /admin-panel/
    Disallow: /archive-2019/
    "
    }

    @hellbait path /wp-admin/* /wp-login.php /xmlrpc.php /.env /.git/* /admin-panel/*
    handle @hellbait {
        reverse_proxy localhost:8098
    }

    # Unlinked path, only exists in robots.txt's Disallow list above. Bots
    # that ignore it fall into an infinite generated link maze.
    handle_path /archive-2019/* {
        reverse_proxy localhost:8099
    }

    reverse_proxy localhost:8082
}

dev.mljr.eu {
    log {
        output file /var/log/caddy/homepage-staging.log {
            roll_size 100mb
            roll_keep 3
            roll_keep_for 168h
            roll_uncompressed
        }
    }
    import security_headers
    reverse_proxy nuc.tail33930.ts.net:18082
}
