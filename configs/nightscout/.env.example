# Nightscout Configuration
# Copy this file to .env and fill in your values

# ==============================================
# Nightscout Core Settings (REQUIRED)
# ==============================================

# API Secret - minimum 12 characters
# This is your master password for Nightscout administration
API_SECRET=PLACEHOLDER_API_SECRET

# Display Units - mg/dl or mmol/L
DISPLAY_UNITS=mg/dl

# Time Format - 12 or 24 hour
TIME_FORMAT=24

# Theme - colors, default, or colorblindfriendly
THEME=colors

# ==============================================
# Database Settings (AUTO-CONFIGURED)
# ==============================================
# These are automatically set in docker-compose.yml
# MONGODB_URI=mongodb://mongo:27017/nightscout
# MONGO_COLLECTION=entries

# ==============================================
# LibreLink Up Connector Settings (REQUIRED)
# ==============================================

# Your LibreLink Up credentials
LINK_UP_USERNAME=PLACEHOLDER_LINK_UP_USERNAME
LINK_UP_PASSWORD=PLACEHOLDER_LINK_UP_PASSWORD

# LibreLink Up Region
# Options: AE, AP, AU, CA, DE, EU, EU2, FR, JP, US, LA, RU, CN
LINK_UP_REGION=EU

# How often to fetch data (in minutes)
LINK_UP_TIME_INTERVAL=1

# LibreLink Up App Version (update if needed)
LINK_UP_VERSION=4.17.0

# ==============================================
# Nightscout API Token (REQUIRED for LibreLink Up Connector)
# ==============================================

# Generate with: echo -n "librelink-connector" | shasum | cut -d ' ' -f 1
NIGHTSCOUT_API_TOKEN=PLACEHOLDER_NIGHTSCOUT_API_TOKEN

# Domain name for Nightscout (used in BASE_URL)
NIGHTSCOUT_DOMAIN=PLACEHOLDER_NIGHTSCOUT_DOMAIN

# ==============================================
# Optional: If you have multiple connections
# ==============================================
# LINK_UP_CONNECTION=patient-id-here

# ==============================================
# Advanced Nightscout Settings (OPTIONAL)
# ==============================================

# Enable plugins - space separated list
ENABLE="careportal basal dbsize"

# Alarm Settings
# BG_HIGH=260
# BG_TARGET_TOP=180
# BG_TARGET_BOTTOM=80
# BG_LOW=55

# Alarm Types: simple or predict
# ALARM_TYPES=simple

# Pushover Notifications (optional)
# PUSHOVER_API_TOKEN=
# PUSHOVER_USER_KEY=

# ==============================================
# System Settings (DO NOT CHANGE)
# ==============================================
TZ=Europe/Berlin
