# Bichon email archiver configuration
# Copy to .env and fill in secrets before deploying

# Root directory inside container (/data is mounted)
BICHON_ROOT_DIR=/data

# Encryption password (required, cannot be changed without recreating data)
BICHON_ENCRYPT_PASSWORD=PLACEHOLDER_BICHON_ENCRYPT_PASSWORD

# Enable login / access token auth
BICHON_ENABLE_ACCESS_TOKEN=true

# Log level (info|debug)
BICHON_LOG_LEVEL=info

# Optional: restrict browser origins (comma-separated, no trailing slashes)
#BICHON_CORS_ORIGINS=https://mail-archive.mljr.eu

# Example IMAP/OAuth configs are set via WebUI/API after first login.
