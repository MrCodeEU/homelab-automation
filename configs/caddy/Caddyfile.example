# Example Caddyfile for Homelab
# Replace with your actual domain names and configurations

# Main site
example.com {
    # Reverse proxy to a local service
    reverse_proxy localhost:8080
    
    # Enable logging
    log {
        output file /var/log/caddy/example.com.log
    }
}

# Another service
app.example.com {
    reverse_proxy localhost:3000
    
    log {
        output file /var/log/caddy/app.example.com.log
    }
}

# Docker service
docker.example.com {
    reverse_proxy localhost:9000
    
    log {
        output file /var/log/caddy/docker.example.com.log
    }
}

# Default catch-all (optional)
:80 {
    respond "Homelab Server" 200
}
